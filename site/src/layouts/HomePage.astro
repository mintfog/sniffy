---
import { Code } from "astro:components";
import Icon from "../components/Icon.astro";
import Lines from "../components/Lines.astro";
import WorkbenchPreview from "../components/WorkbenchPreview.astro";
import {
  languages,
  localePath,
  otherLang,
  siteCopy,
  type Lang,
} from "../i18n/ui";
import "../styles/home.css";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const copy = siteCopy(lang).home;
const alternate = otherLang(lang);
const repository = "https://github.com/mintfog/sniffy";
const releases = `${repository}/releases`;
const pluginDocs = `${repository}/blob/main/docs/plugins-helpers.md`;
const docsPath = localePath(lang, "/docs/");
const pluginCode = `function onRequest(flow) {
  if (flow.path !== '/api/profile') return;

  mock({
    status: 200,
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({
      name: 'Sniffy',
      plan: 'pro',
      ready: true,
    }),
  });
}`;
const featureMeta = [
  { number: "01", icon: "activity" as const },
  { number: "02", icon: "sliders" as const },
  { number: "03", icon: "code" as const },
];
const downloadMeta = [
  { icon: "apple" as const, size: 25 },
  { icon: "windows" as const, size: 24 },
  { icon: "linux" as const, size: 26 },
];
const menuLabels = {
  open: copy.a11y.openMenu,
  close: copy.a11y.closeMenu,
};
const copyLabels = {
  idle: copy.plugins.copy,
  done: copy.plugins.copied,
  failed: copy.plugins.copyManually,
  doneMessage: copy.a11y.copyDone,
  failedMessage: copy.a11y.copyFailed,
};
---

<!doctype html>
<html lang={languages[lang].htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={copy.meta.description} />
    <meta name="theme-color" content="#f7f9f6" />
    <meta property="og:title" content={copy.meta.ogTitle} />
    <meta property="og:description" content={copy.meta.ogDescription} />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/png" href="/sniffy-mark.png" />
    <title>{copy.meta.title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">
      {copy.a11y.skipLink}
    </a>
    <header class="site-header">
      <div class="container nav-wrap">
        <a
          class="brand"
          href={localePath(lang, "/")}
          aria-label={copy.a11y.brandHome}
        >
          <img src="/sniffy-mark.png" alt="" width="36" height="36" />
          <span>
            sniffy<span class="brand-dot">.</span>
          </span>
        </a>
        <nav class="desktop-nav" aria-label={copy.a11y.mainNav}>
          <a href="#features">{copy.nav.features}</a>
          <a href="#plugins">{copy.nav.plugins}</a>
          <a href={docsPath}>
            {copy.nav.docs} <Icon name="chevron" size={12} />
          </a>
          <a href={repository}>
            {copy.nav.github} <Icon name="external" size={12} />
          </a>
        </nav>
        <div class="nav-actions">
          <a
            class="lang-switch"
            href={localePath(alternate, "/")}
            lang={languages[alternate].htmlLang}
            aria-label={copy.a11y.switchLang}
          >
            <Icon name="globe" size={14} />
            {languages[alternate].short}
          </a>
          <a class="button button-small button-dark" href="#download">
            {copy.nav.download} <Icon name="download" size={15} />
          </a>
          <button
            class="menu-toggle"
            type="button"
            aria-label={copy.a11y.openMenu}
            aria-expanded="false"
            aria-controls="mobile-nav"
          >
            <Icon name="menu" />
          </button>
        </div>
      </div>
      <nav id="mobile-nav" class="mobile-nav" aria-label={copy.a11y.mobileNav} hidden>
        <a href="#features">{copy.mobileNav.features}</a>
        <a href="#plugins">{copy.mobileNav.plugins}</a>
        <a href={docsPath}>{copy.mobileNav.docs}</a>
        <a href={repository}>{copy.mobileNav.github}</a>
        <a
          href={localePath(alternate, "/")}
          lang={languages[alternate].htmlLang}
        >
          {languages[alternate].label}
        </a>
      </nav>
    </header>
    <main id="main">
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-grid" aria-hidden="true"></div>
        <div class="container hero-content">
          <h1 id="hero-title">
            {copy.hero.title.lead}{" "}
            <br />
            <span>{copy.hero.title.highlight}</span>
          </h1>
          <p class="hero-description">
            <Lines lines={copy.hero.description} brClass="desktop-break" />
          </p>
          <div class="hero-actions">
            <a class="button button-primary" href="#download">
              <Icon name="download" size={18} stroke={1.8} />
              {copy.hero.download}
              <Icon name="arrow" size={16} />
            </a>
            <a class="button button-outline" href={docsPath}>
              {copy.hero.readDocs}
              <Icon name="book" size={17} />
            </a>
          </div>
          <p class="platform-line">
            <span>
              <Icon name="apple" size={14} />
              macOS
            </span>
            <span>
              <Icon name="windows" size={13} />
              Windows
            </span>
            <span>
              <Icon name="linux" size={15} />
              Linux
            </span>
            <i></i>
            <span>{copy.hero.license}</span>
          </p>
          <div class="preview-wrap">
            <div class="preview-caption">
              <span>
                <span class="little-cross">+</span>
                {copy.hero.previewLeft}
              </span>
              <span>
                {copy.hero.previewRight} <span class="little-cross">+</span>
              </span>
            </div>
            <WorkbenchPreview lang={lang} />
            <div class="preview-footnote">
              <span class="status-dot"></span>
              {copy.hero.footnote}
              <span class="footnote-line"></span>
              <span class="mono">{copy.hero.footnoteMono}</span>
            </div>
          </div>
        </div>
      </section>
      <div class="protocol-strip">
        <div class="container">
          <span>{copy.protocols.intro}</span>
          <div>
            {copy.protocols.items.map((item, index) => (
              <Fragment>
                {index > 0 && <span>＋</span>}
                <b>{item}</b>
              </Fragment>
            ))}
          </div>
        </div>
      </div>
      <section
        id="features"
        class="section features container"
        aria-labelledby="features-title"
      >
        <div class="section-heading">
          <div>
            <p class="eyebrow section-eyebrow">
              <span class="section-index">01 /</span>
              {copy.features.eyebrow}
            </p>
            <h2 id="features-title">{copy.features.title}</h2>
          </div>
          <p>
            <Lines lines={copy.features.aside} />
          </p>
        </div>
        <div class="feature-grid">
          {copy.features.cards.map((feature, index) => (
            <article class="feature-card">
              <div class="feature-top">
                <span class="feature-icon">
                  <Icon name={featureMeta[index].icon} size={24} stroke={1.75} />
                </span>
                <span class="mono feature-number">
                  {featureMeta[index].number}
                </span>
              </div>
              <h3>{feature.title}</h3>
              <p>{feature.text}</p>
              <div class="feature-tags">
                {feature.tags.map((tag) => (
                  <span>{tag}</span>
                ))}
              </div>
            </article>
          ))}
        </div>
      </section>
      <section
        id="plugins"
        class="plugin-section container"
        aria-labelledby="plugin-title"
      >
        <div class="plugin-copy">
          <p class="eyebrow section-eyebrow">
            <span class="section-index">02 /</span>
            {copy.plugins.eyebrow}
          </p>
          <span class="label-chip">
            <Icon name="code" size={14} />
            {copy.plugins.chip}
          </span>
          <h2 id="plugin-title">
            <Lines lines={copy.plugins.title} />
          </h2>
          <p>
            <Lines lines={copy.plugins.description} />
          </p>
          <ul class="plugin-benefits">
            {copy.plugins.benefits.map((benefit) => (
              <li>
                <Icon name="check" size={16} />
                {benefit}
              </li>
            ))}
          </ul>
          <a class="text-link" href={pluginDocs}>
            {copy.plugins.link}
            <Icon name="arrow" size={17} />
          </a>
        </div>
        <div class="plugin-editor">
          <div class="editor-title">
            <span>
              <span class="js-icon">JS</span>
              {copy.plugins.fileName}
            </span>
            <button
              type="button"
              class="copy-button"
              data-copy-code
              aria-label={copy.a11y.copyExample}
            >
              <Icon name="copy" size={15} />
              <span>{copy.plugins.copy}</span>
            </button>
          </div>
          <div class="editor-code">
            <Code code={pluginCode} lang="js" theme="github-dark" />
          </div>
          <div class="editor-output">
            <span class="output-label">
              <span class="status-dot"></span>
              {copy.plugins.outputLabel}
            </span>
            <span class="output-code">
              {copy.plugins.outputCode} <span>·</span> application/json
            </span>
            <p>
              {copy.plugins.outputNote}
              <Icon name="bolt" size={16} />
            </p>
          </div>
          <span
            class="copy-announcement sr-only"
            role="status"
            aria-live="polite"
          ></span>
        </div>
      </section>
      <section
        class="section editions container"
        aria-labelledby="editions-title"
      >
        <div class="section-heading">
          <div>
            <p class="eyebrow section-eyebrow">
              <span class="section-index">03 /</span>
              {copy.editions.eyebrow}
            </p>
            <h2 id="editions-title">{copy.editions.title}</h2>
          </div>
          <p>
            <Lines lines={copy.editions.aside} />
          </p>
        </div>
        <div class="edition-grid">
          <article class="edition-card">
            <div class="edition-icon">
              <Icon name="monitor" size={24} stroke={1.75} />
            </div>
            <span class="edition-label mono">DESKTOP</span>
            <h3>{copy.editions.desktop.title}</h3>
            <p>
              <Lines lines={copy.editions.desktop.text} />
            </p>
            <a class="text-link" href={localePath(lang, "/docs/desktop/")}>
              {copy.editions.desktop.link}
              <Icon name="arrow" size={17} />
            </a>
            <div class="edition-bottom">
              <span>
                <Icon name="apple" size={15} />
                macOS
              </span>
              <span>
                <Icon name="windows" size={14} />
                Windows
              </span>
              <span>
                <Icon name="linux" size={15} />
                Linux
              </span>
            </div>
          </article>
          <article class="edition-card headless-card">
            <div class="edition-icon">
              <Icon name="terminal" size={24} stroke={1.75} />
            </div>
            <span class="edition-label mono">HEADLESS</span>
            <h3>{copy.editions.headless.title}</h3>
            <p>
              <Lines lines={copy.editions.headless.text} />
            </p>
            <a class="text-link" href={localePath(lang, "/docs/headless/")}>
              {copy.editions.headless.link}
              <Icon name="arrow" size={17} />
            </a>
            <div class="terminal-line">
              <span>$</span>
              <code>go run ./cmd/sniffy</code>
              <span class="terminal-cursor" aria-hidden="true"></span>
            </div>
          </article>
        </div>
      </section>
      <section
        id="download"
        class="download-section"
        aria-labelledby="download-title"
      >
        <div class="container download-inner">
          <div class="download-intro">
            <p class="eyebrow section-eyebrow">
              <span class="status-dot"></span>
              {copy.download.eyebrow}
            </p>
            <h2 id="download-title">
              <Lines lines={copy.download.title} />
            </h2>
            <p>
              <Lines lines={copy.download.description} />
            </p>
            <a class="text-link" href={releases}>
              {copy.download.allReleases}
              <Icon name="external" size={15} />
            </a>
          </div>
          <div class="download-options">
            {copy.download.options.map((option, index) => (
              <a class="download-option" href={releases}>
                <span class="os-icon">
                  <Icon
                    name={downloadMeta[index].icon}
                    size={downloadMeta[index].size}
                    stroke={1.75}
                  />
                </span>
                <span>
                  <strong>{option.name}</strong>
                  <small>{option.detail}</small>
                </span>
                <span class="download-option-action">
                  {copy.download.action}
                  <Icon name="arrow" size={18} />
                </span>
              </a>
            ))}
            <p class="headless-download">
              {copy.download.headlessPrompt}
              <a href={localePath(lang, "/docs/headless/")}>
                {copy.download.headlessLink}
                <Icon name="arrow" size={14} />
              </a>
            </p>
          </div>
        </div>
      </section>
    </main>
    <footer class="site-footer container">
      <div class="footer-top">
        <div>
          <a
            class="brand"
            href={localePath(lang, "/")}
            aria-label={copy.a11y.brandHome}
          >
            <img src="/sniffy-mark.png" alt="" width="32" height="32" />
            <span>
              sniffy<span class="brand-dot">.</span>
            </span>
          </a>
          <p>{copy.footer.tagline}</p>
        </div>
        <div class="footer-links">
          <a href={docsPath}>{copy.footer.docs}</a>
          <a href={`${repository}/issues`}>{copy.footer.issues}</a>
          <a href={repository}>
            {copy.footer.github}
            <Icon name="external" size={12} />
          </a>
        </div>
      </div>
      <div class="footer-bottom">
        <span>© {new Date().getFullYear()} {copy.footer.copyright}</span>
        <a href={`${repository}/blob/main/LICENSE`}>{copy.footer.license}</a>
        <span class="mono">{copy.footer.mono}</span>
      </div>
    </footer>
    <script define:vars={{ pluginCode, menuLabels, copyLabels }}>
      const menuToggle = document.querySelector(".menu-toggle");
      const mobileNav = document.querySelector("#mobile-nav");
      function closeMenu() {
        menuToggle.setAttribute("aria-expanded", "false");
        menuToggle.setAttribute("aria-label", menuLabels.open);
        mobileNav.hidden = true;
      }
      menuToggle.addEventListener("click", () => {
        const expanded = menuToggle.getAttribute("aria-expanded") === "true";
        menuToggle.setAttribute("aria-expanded", String(!expanded));
        menuToggle.setAttribute(
          "aria-label",
          expanded ? menuLabels.open : menuLabels.close,
        );
        mobileNav.hidden = expanded;
      });
      mobileNav
        .querySelectorAll("a")
        .forEach((link) => link.addEventListener("click", closeMenu));
      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape" && !mobileNav.hidden) {
          closeMenu();
          menuToggle.focus();
        }
      });
      window
        .matchMedia("(min-width: 761px)")
        .addEventListener("change", (event) => {
          if (event.matches) closeMenu();
        });
      const copyButton = document.querySelector("[data-copy-code]");
      copyButton.addEventListener("click", async () => {
        const label = copyButton.querySelector("span");
        const announcement = document.querySelector(".copy-announcement");
        try {
          await navigator.clipboard.writeText(pluginCode);
          label.textContent = copyLabels.done;
          announcement.textContent = copyLabels.doneMessage;
        } catch {
          label.textContent = copyLabels.failed;
          announcement.textContent = copyLabels.failedMessage;
        }
        window.setTimeout(() => {
          label.textContent = copyLabels.idle;
        }, 2500);
      });
    </script>
  </body>
</html>
