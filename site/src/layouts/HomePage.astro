---
import SiteLayout from "./SiteLayout.astro";
import "../styles/motion.css";
import HeroSection from "../components/HeroSection.astro";
import FeatureSection from "../components/FeatureSection.astro";
import DemoShowcaseSection from "../components/DemoShowcaseSection.astro";
import PluginSection from "../components/PluginSection.astro";
import EditionSection from "../components/EditionSection.astro";
import OpenSourceSection from "../components/OpenSourceSection.astro";
import { siteCopy, type Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<SiteLayout lang={lang} path="/" meta={siteCopy[lang].home.meta}>
  <HeroSection lang={lang} />
  <FeatureSection lang={lang} />
  <DemoShowcaseSection lang={lang} />
  <PluginSection lang={lang} />
  <EditionSection lang={lang} />
  <OpenSourceSection lang={lang} />
</SiteLayout>

<script>
  import "../scripts/home-motion";
</script>
