---
import Icon from "./Icon.astro";
import type { IconName } from "./icons";
import {
  ruleActions,
  ruleConditions,
  type RuleAction,
} from "../data/rule-demo";
import { localePath, siteCopy, type Lang } from "../i18n/ui";
import "../styles/rules.css";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const { rules: copy, automation } = siteCopy[lang].home;
const actions: { id: RuleAction; icon: IconName; preview: string }[] = [
  {
    id: "redirect",
    icon: "shuffle",
    preview: ruleActions.redirect.parameters.url,
  },
  {
    id: "header",
    icon: "sliders",
    preview: `${ruleActions.header.parameters.name}: ${ruleActions.header.parameters.value}`,
  },
  {
    id: "mock",
    icon: "braces",
    preview: `${ruleActions.mock.parameters.response.status} OK · ${ruleActions.mock.parameters.response.contentType}`,
  },
];
---

<section
  id="rules"
  class="demo-panel"
  aria-label={automation.rules}
  data-rule-demo
>
  <div class="rule-scenarios" role="group" aria-label={copy.choose}>
    {actions.map((action, index) => (
      <button
        type="button"
        class="rule-scenario"
        data-rule-action={action.id}
        data-note={copy.actions[action.id].note}
        data-effect={copy.actions[action.id].effect}
        aria-pressed={index === 0}
        aria-controls="rule-flow"
      >
        <span class="rule-scenario-icon">
          <Icon name={action.icon} size={21} stroke={1.7} />
        </span>
        <span class="rule-scenario-copy">
          <strong>{copy.actions[action.id].label}</strong>
          <span>{copy.actions[action.id].caption}</span>
        </span>
        <span class="rule-scenario-index" aria-hidden="true">
          0{index + 1}
        </span>
        <Icon name="arrow" size={16} class="rule-scenario-arrow" />
      </button>
    ))}
  </div>
  <div
    id="rule-flow"
    class="rule-workspace"
    data-demo-flow="rules"
    data-pending={automation.running}
    data-running={automation.running}
    data-failed={automation.failed}
    data-matched={copy.matched}
    data-missed={copy.missed}
    data-disabled={copy.disabled}
    data-forwarded={copy.forwarded}
  >
    <div class="rule-recipe">
      <div class="rule-recipe-heading">
        <h3>
          <Icon name="sliders" size={16} />
          {copy.configuration}
        </h3>
        <label class="rule-switch">
          <span>{copy.enabled}</span>
          <input
            class="sr-only"
            type="checkbox"
            role="switch"
            data-rule-enabled
            checked
          />
          <span class="rule-switch-track" aria-hidden="true"></span>
        </label>
      </div>
      <div class="rule-recipe-body">
        <div class="rule-step-heading">
          <span class="rule-step-number">01</span>
          <h4>{copy.match}</h4>
          <span class="rule-logic" title={copy.all}>
            AND
          </span>
        </div>
        <p class="rule-condition-caption">{copy.all}</p>
        <dl class="rule-conditions">
          <div>
            <dt>
              <span>{copy.host}</span>
              <span>{copy.equals}</span>
            </dt>
            <dd>
              <code>{ruleConditions.host}</code>
              <span
                data-condition-state
                data-pass={copy.pass}
                data-fail={copy.fail}
              >
                —
              </span>
            </dd>
          </div>
          <div>
            <dt>
              <span>{copy.path}</span>
              <span>{copy.startsWith}</span>
            </dt>
            <dd>
              <code>{ruleConditions.path}</code>
              <span
                data-condition-state
                data-pass={copy.pass}
                data-fail={copy.fail}
              >
                —
              </span>
            </dd>
          </div>
        </dl>
        <div class="rule-step-heading">
          <span class="rule-step-number">02</span>
          <h4>{copy.then}</h4>
          <Icon name="caret" size={14} />
        </div>
        {actions.map((action, index) => (
          <div
            class="rule-action"
            data-action-summary={action.id}
            hidden={index !== 0}
          >
            <div>
              <Icon name={action.icon} size={17} />
              <strong>{copy.actions[action.id].label}</strong>
            </div>
            <code>{action.preview}</code>
          </div>
        ))}
        <p class="rule-explanation" data-demo-note>
          {copy.actions.redirect.note}
        </p>
      </div>
    </div>
    <div class="rule-preview">
      <div class="rule-preview-toolbar">
        <h3>
          <Icon name="terminal" size={16} />
          {copy.preview}
        </h3>
        <div class="rule-samples" role="group" aria-label={copy.request}>
          <button
            type="button"
            data-rule-sample={ruleConditions.host}
            aria-pressed="true"
          >
            {copy.sample}
          </button>
          <button
            type="button"
            data-rule-sample="www.example.com"
            aria-pressed="false"
          >
            {copy.other}
          </button>
        </div>
      </div>
      <div class="rule-preview-body">
        <div>
          <div class="rule-packet-label">
            <span>{copy.before}</span>
            <span class="rule-protocol">HTTPS</span>
          </div>
          <div class="rule-request-url">
            <span class="rule-method">GET</span>
            <code data-rule-host>{ruleConditions.host}</code>
          </div>
          <p class="rule-url-path">/api/profile?debug=1</p>
          <p class="rule-request-header">
            <span>Accept</span>
            <code>application/json</code>
          </p>
        </div>
        <div class="rule-transit" aria-hidden="true">
          <span></span>
          <span class="rule-transit-chip">
            <Icon name="bolt" size={13} />
            sniffy
            <Icon name="caret" size={13} />
          </span>
          <span></span>
        </div>
        <div class="rule-packet-after">
          <div class="rule-packet-label">
            <span>{copy.after}</span>
            <span class="rule-effect" data-rule-effect></span>
          </div>
          <div class="rule-waiting" data-demo-placeholder>
            <Icon name="activity" size={22} />
            <span>{automation.running}</span>
          </div>
          <div data-demo-output hidden></div>
        </div>
      </div>
      <div class="rule-preview-footer">
        <p
          class="rule-result-status"
          data-demo-status
          role="status"
          aria-live="polite"
        >
          {automation.running}
        </p>
      </div>
    </div>
  </div>
  <div class="demo-under">
    <span>{automation.local}</span>
    <a class="text-link" href={localePath(lang, "/docs/rules/")}>
      {copy.link}
      <Icon name="arrow" size={15} />
    </a>
  </div>
</section>

<script>
  import "../scripts/rule-demo";
</script>
