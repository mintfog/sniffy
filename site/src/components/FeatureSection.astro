---
import Icon from "./Icon.astro";
import type { IconName } from "./icons";
import { localePath, siteCopy, type FeatureKey, type Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const copy = siteCopy[lang].home.features;

const items: { id: FeatureKey; icon: IconName; path: string }[] = [
  { id: "capture", icon: "activity", path: "/docs/workbench/" },
  { id: "rules", icon: "shuffle", path: "/docs/rules/" },
  { id: "breakpoints", icon: "dot", path: "/docs/breakpoints/" },
  { id: "plugins", icon: "code", path: "/docs/plugins/" },
  { id: "compose", icon: "send", path: "/docs/compose/" },
  { id: "har", icon: "hardDrive", path: "/docs/capture/" },
];
---

<section
  id="features"
  class="features frame-section"
  aria-labelledby="features-title"
>
  <div class="frame-inner section-pad">
    <div class="features-head">
      <h2 id="features-title">{copy.title}</h2>
      <p>{copy.description}</p>
    </div>

    <div class="feature-list">
      {items.map((item) => {
        const card = copy.cards[item.id];
        return (
          <article class="feature-item">
            <h3 class="feature-title">
              <Icon name={item.icon} size={17} stroke={1.9} />
              <span>{card.title}</span>
            </h3>
            <p class="feature-text">{card.text}</p>
            <a class="text-link" href={localePath(lang, item.path)}>
              {card.link}
              <Icon name="arrow" size={14} />
            </a>
          </article>
        );
      })}
    </div>
  </div>
</section>

<style>
  .features {
    background: var(--bg);
  }
  .features-head {
    max-width: 640px;
    margin-bottom: 40px;
  }
  .features-head p {
    margin-top: 10px;
    font-size: 15.5px;
    line-height: 1.65;
    color: var(--muted);
  }
  .feature-list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 36px 40px;
  }
  .feature-item {
    display: flex;
    flex-direction: column;
    padding-top: 20px;
    border-top: 1px solid var(--line);
    min-width: 0;
  }
  .feature-title {
    display: flex;
    align-items: center;
    gap: 9px;
    font-size: 16px;
    font-weight: 600;
    color: var(--ink);
  }
  .feature-title :global(svg) {
    color: var(--accent);
  }
  .feature-text {
    margin-top: 10px;
    flex: 1;
    color: var(--muted);
    font-size: 14px;
    line-height: 1.72;
  }
  .feature-item .text-link {
    margin-top: 14px;
    font-size: 13px;
  }

  @media (max-width: 920px) {
    .feature-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 28px 32px;
    }
  }
  @media (max-width: 600px) {
    .features-head {
      margin-bottom: 28px;
    }
    .features-head p {
      font-size: 14.5px;
    }
    .feature-list {
      grid-template-columns: minmax(0, 1fr);
      gap: 24px;
    }
  }
</style>
