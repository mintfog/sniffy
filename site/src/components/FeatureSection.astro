---
import Icon from "./Icon.astro";
import FlowIllustration from "./FlowIllustration.astro";
import SectionHeading from "./SectionHeading.astro";
import { localePath, siteCopy, type Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const copy = siteCopy[lang].home.features;
const features = [
  {
    id: "capture",
    number: "01",
    path: "/docs/workbench/",
    ...copy.cards.capture,
  },
  {
    id: "debug",
    number: "02",
    path: "/docs/rules/",
    ...copy.cards.debug,
  },
  {
    id: "plugins",
    number: "03",
    path: "/docs/plugins/",
    ...copy.cards.plugins,
  },
] as const;
---

<section
  id="features"
  class="section features container"
  aria-labelledby="features-title"
>
  <SectionHeading
    id="features-title"
    eyebrow={copy.eyebrow}
    title={copy.title}
    aside={copy.aside}
  />
  <div class="feature-grid">
    {features.map((feature, index) => (
      <article
        class="feature-card"
        data-reveal
        data-reveal-delay={index * 80}
      >
        <p class="feature-number mono">
          {feature.number} / {feature.label}
        </p>
        <div class="feature-visual">
          <FlowIllustration kind={feature.id} />
        </div>
        <h3>{feature.title}</h3>
        <p>{feature.text}</p>
        <div class="feature-tags">
          {feature.tags.map((tag) => (
            <span>{tag}</span>
          ))}
        </div>
        <a class="text-link" href={localePath(lang, feature.path)}>
          {feature.link}
          <Icon name="arrow" size={16} />
        </a>
      </article>
    ))}
  </div>
</section>

<style>
  .features {
    padding-inline: 32px;
  }
  .feature-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin-top: 54px;
  }
  .feature-card {
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: 0 32px;
    border-right: 1px solid var(--line);
  }
  .feature-card:first-child {
    padding-left: 0;
  }
  .feature-card:last-child {
    padding-right: 0;
    border-right: 0;
  }
  .feature-number {
    font-size: 12px;
    font-weight: 500;
    color: var(--muted);
    letter-spacing: 1px;
  }
  .feature-visual {
    margin-block: 10px 14px;
  }
  .feature-card h3 {
    font-size: clamp(19px, 2.2vw, 26px);
    line-height: 1.5;
  }
  .feature-card > p:not(.feature-number) {
    flex: 1;
    color: var(--muted);
    font-size: 14px;
    line-height: 1.8;
    margin-top: 12px;
  }
  .feature-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    margin-top: 18px;
  }
  .feature-tags span {
    padding: 5px 10px;
    border-radius: 20px;
    background: #edf4f1;
    color: #526e72;
    font-size: 11px;
  }
  .feature-card > .text-link {
    margin-top: 25px;
    padding-top: 20px;
    border-top: 1px solid var(--line);
  }
  @media (max-width: 1000px) {
    .features {
      padding-inline: 24px;
    }
    .feature-card {
      padding-inline: 23px;
    }
    .feature-card > p:not(.feature-number) {
      font-size: 13px;
    }
  }
  @media (max-width: 760px) {
    .features {
      padding-inline: 4px;
    }
    .feature-grid {
      grid-template-columns: minmax(0, 1fr);
      margin-top: 32px;
      gap: 32px;
    }
    .feature-card,
    .feature-card:first-child,
    .feature-card:last-child {
      padding: 0;
      border: 0;
    }
    .feature-visual {
      max-width: 300px;
      margin: 0 auto 8px;
      width: 100%;
    }
    .feature-card h3 {
      font-size: 23px;
    }
    .feature-card > p:not(.feature-number) {
      font-size: 14px;
    }
    .feature-card > .text-link {
      margin-top: 20px;
      padding-block: 16px 6px;
    }
  }
</style>
