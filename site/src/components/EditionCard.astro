---
import Icon from "./Icon.astro";
import Lines from "./Lines.astro";
import DeploymentIllustration from "./DeploymentIllustration.astro";
import type { Paragraph } from "../i18n/ui";

interface Props {
  label: string;
  title: string;
  text: Paragraph;
  href: string;
  link: string;
  variant?: "desktop" | "headless";
}

const { label, title, text, href, link, variant = "desktop" } = Astro.props;
---

<article
  class:list={["edition-card", { "headless-card": variant === "headless" }]}
>
  <div class="edition-illustration">
    <DeploymentIllustration kind={variant} />
  </div>
  <span class="edition-label mono">{label}</span>
  <h3>{title}</h3>
  <p>
    <Lines lines={text} />
  </p>
  <a class="text-link" href={href}>
    {link}
    <Icon name="arrow" size={17} />
  </a>
  <slot />
</article>

<style>
  .edition-card {
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: 12px 28px 0;
    background: #fffefe;
    border: 1px solid var(--line);
    border-radius: 10px;
    overflow: hidden;
  }
  .edition-illustration {
    margin: 0 -15px -5px;
  }
  .edition-label {
    font-size: 11px;
    letter-spacing: 2px;
    color: var(--muted);
    margin-bottom: 23px;
  }
  .edition-card h3 {
    font-size: clamp(22px, 2.65vw, 30px);
    line-height: 1.5;
    letter-spacing: -0.6px;
  }
  .edition-card > p {
    font-size: 15px;
    color: var(--muted);
    line-height: 1.8;
    margin-top: 10px;
  }
  .edition-card > .text-link {
    margin-block: 15px 25px;
  }
  .headless-card {
    background: linear-gradient(135deg, #f1faf5, #f7fcf9);
  }
  @media (max-width: 1100px) {
    .edition-card {
      padding-inline: 25px;
    }
    .edition-card > p {
      font-size: 14px;
    }
    .edition-card > p :global(br) {
      display: none;
    }
  }
  @media (max-width: 760px) {
    .edition-card {
      padding: 4px 23px 0;
    }
    .edition-illustration {
      max-width: 500px;
      align-self: center;
      width: calc(100% + 30px);
    }
    .edition-label {
      margin-bottom: 16px;
      font-size: 10px;
    }
    .edition-card h3 {
      font-size: 24px;
    }
  }
</style>
