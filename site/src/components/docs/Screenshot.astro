---
// 截图更新时使用新的版本前缀并修改 BASE，避免 CDN 与浏览器缓存继续返回旧图。
const BASE = "https://cdn.gosniffy.com/screenshots/v1";

// 远程图片缺少构建期元数据，登记原始尺寸用于预留布局空间；未登记的截图显示占位框。
const SIZES: Record<string, [number, number]> = {
  "breakpoints-editor.png": [2880, 1620],
  "breakpoints-overview.png": [2880, 1620],
  "certs-guide-android.png": [2880, 1620],
  "certs-guide-ios.png": [2880, 1620],
  "certs-install.png": [2800, 1516],
  "certs-overview.png": [2880, 1620],
  "compose-curl-import.png": [2880, 1620],
  "compose-window.png": [2880, 1620],
  "plugins-editor.png": [2880, 1620],
  "proxy-bar.png": [2880, 88],
  "rules-editor.png": [2880, 1620],
  "settings-decrypt-scope.png": [1656, 470],
  "settings-overview.png": [2880, 1620],
  "workbench-body-viewer.png": [1440, 794],
  "workbench-detail-panel.png": [2880, 1620],
  "workbench-overview.png": [2880, 1620],
  "workbench-toolbox.png": [2880, 1620],
  "workbench-traffic-list.png": [2880, 1572],
  "workbench-ws-session.png": [2880, 1620],
};

// BASE/en/ 下的英文截图与 SIZES 共用尺寸，未登记时回退到中文图。
// 英文图尺寸变化时需单独登记宽高，以保证预留空间准确。
const EN_SHOTS = new Set([
  "breakpoints-editor.png",
  "breakpoints-overview.png",
  "certs-guide-android.png",
  "certs-guide-ios.png",
  "certs-install.png",
  "certs-overview.png",
  "compose-curl-import.png",
  "compose-window.png",
  "plugins-editor.png",
  "proxy-bar.png",
  "rules-editor.png",
  "settings-decrypt-scope.png",
  "settings-overview.png",
  "workbench-body-viewer.png",
  "workbench-detail-panel.png",
  "workbench-overview.png",
  "workbench-toolbox.png",
  "workbench-traffic-list.png",
  "workbench-ws-session.png",
]);

interface Props {
  /** CDN 上的文件名，含扩展名。 */
  src: string;
  /** 图片描述，同时作为占位框里的说明文字。 */
  alt: string;
  caption?: string;
}

const { src, alt, caption } = Astro.props;

const zh = !Astro.currentLocale || Astro.currentLocale.startsWith("zh");
const pendingLabel = zh ? "截图待补充" : "Screenshot pending";
const enlargeLabel = zh ? "点击放大" : "Enlarge image";
const closeLabel = zh ? "关闭大图" : "Close image preview";
const originalLabel = zh ? "查看原图" : "Open original image";

const size = SIZES[src];
const en = !zh && EN_SHOTS.has(src);
const url = `${BASE}/${en ? "en/" : ""}${src}`;
---

<figure class="doc-shot">
  {
    size ? (
      <doc-screenshot>
        <a
          class="doc-shot__trigger"
          href={url}
          target="_blank"
          rel="noreferrer"
          aria-label={`${enlargeLabel}: ${alt}`}
          aria-haspopup="dialog"
          title={enlargeLabel}
        >
          <img
            class="doc-shot__image"
            src={url}
            alt={alt}
            width={size[0]}
            height={size[1]}
            loading="lazy"
            decoding="async"
          />
        </a>
        <dialog
          class="doc-shot__dialog not-content"
          aria-label={alt}
          data-pagefind-ignore
        >
          <form method="dialog" class="doc-shot__toolbar">
            <a href={url} target="_blank" rel="noreferrer">{originalLabel}</a>
            <button
              type="submit"
              aria-label={closeLabel}
              title={closeLabel}
              autofocus
            >
              <svg
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                aria-hidden="true"
              >
                <path d="m6 6 12 12M6 18 18 6" />
              </svg>
            </button>
          </form>
          <figure class="doc-shot__preview">
            <img
              class="doc-shot__preview-image"
              alt={alt}
              width={size[0]}
              height={size[1]}
              decoding="async"
            />
            {caption && <figcaption>{caption}</figcaption>}
          </figure>
        </dialog>
      </doc-screenshot>
    ) : (
      <div class="doc-shot__slot" role="img" aria-label={alt}>
        <span class="doc-shot__badge">{pendingLabel}</span>
        <p class="doc-shot__alt">{alt}</p>
        <code class="doc-shot__path">{src}</code>
      </div>
    )
  }
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<script>
  class DocScreenshot extends HTMLElement {
    constructor() {
      super();
      const trigger = this.querySelector<HTMLAnchorElement>(".doc-shot__trigger")!;
      const dialog = this.querySelector("dialog")!;
      if (typeof dialog.showModal !== "function") return;

      const image = dialog.querySelector("img")!;
      trigger.addEventListener("click", (event) => {
        if (
          event.button !== 0 ||
          event.ctrlKey ||
          event.metaKey ||
          event.shiftKey ||
          event.altKey
        ) {
          return;
        }

        event.preventDefault();
        image.src = trigger.href;
        dialog.showModal();
      });
      dialog.addEventListener("click", (event) => {
        if (event.target === dialog) dialog.close();
      });
      dialog.addEventListener("close", () =>
        trigger.focus({ preventScroll: true }),
      );
    }
  }

  customElements.define("doc-screenshot", DocScreenshot);
</script>

<style>
  .doc-shot {
    margin: 1.5rem 0;
  }

  doc-screenshot,
  .doc-shot__trigger {
    display: block;
  }

  .doc-shot__trigger {
    cursor: zoom-in;
    border-radius: 0.5rem;
  }

  .doc-shot__trigger:focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 4px;
  }

  .doc-shot__image {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
  }

  .doc-shot figcaption {
    margin-top: 0.5rem;
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-sm);
    text-align: center;
  }

  :global(html:has(.doc-shot__dialog[open])) {
    overflow: hidden;
  }

  .doc-shot__dialog {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 4.5rem 1rem 1.5rem;
    border: 0;
    background: transparent;
    color: #fff;
  }

  .doc-shot__dialog[open] {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .doc-shot__dialog::backdrop {
    background: rgb(0 0 0 / 85%);
  }

  .doc-shot__toolbar {
    position: absolute;
    top: 1rem;
    right: 1rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .doc-shot__toolbar a,
  .doc-shot__toolbar button {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 2.75rem;
    min-height: 2.75rem;
    padding: 0.5rem 0.75rem;
    border: 1px solid rgb(255 255 255 / 35%);
    border-radius: 0.5rem;
    background: rgb(0 0 0 / 40%);
    color: #fff;
    font: inherit;
    font-size: var(--sl-text-sm);
    text-decoration: none;
    cursor: pointer;
  }

  .doc-shot__toolbar a:hover,
  .doc-shot__toolbar button:hover {
    background: rgb(255 255 255 / 15%);
  }

  .doc-shot__preview {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    max-width: 100%;
    margin: 0;
  }

  .doc-shot__preview-image {
    display: block;
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: calc(100dvh - 10rem);
    object-fit: contain;
    border-radius: 0.5rem;
  }

  .doc-shot__preview figcaption {
    margin: 0;
    color: #ddd;
  }

  /* 占位框刻意保持低饱和：它是待办标记，不该在正文里抢注意力。 */
  .doc-shot__slot {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    align-items: center;
    justify-content: center;
    min-height: 9rem;
    padding: 1.75rem 1rem;
    border: 1px dashed var(--sl-color-gray-4);
    border-radius: 0.5rem;
    background: var(--sl-color-gray-7, var(--sl-color-gray-6));
    text-align: center;
  }

  .doc-shot__badge {
    padding: 0.125rem 0.5rem;
    border-radius: 999px;
    background: var(--sl-color-gray-5);
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-xs);
    letter-spacing: 0.04em;
  }

  .doc-shot__alt {
    max-width: 34rem;
    margin: 0;
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-sm);
    line-height: 1.5;
  }

  .doc-shot__path {
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-xs);
  }
</style>
