---
import { release } from "../../data/release";
import { siteCopy } from "../../i18n/ui";
import {
  desktopAssets,
  formatArchitecture,
  formatSize,
} from "../../lib/downloads";

interface Props {
  /** desktop 列安装包，headless 列免安装可执行文件。 */
  edition: "desktop" | "headless";
}

const { edition } = Astro.props;

const zh = !Astro.currentLocale || Astro.currentLocale.startsWith("zh");
const t = zh
  ? { os: "系统", arch: "架构", file: "文件", size: "大小", version: "版本" }
  : {
      os: "Platform",
      arch: "Architecture",
      file: "File",
      size: "Size",
      version: "Version",
    };

const osNames: Record<string, string> = {
  darwin: "macOS",
  windows: "Windows",
  linux: "Linux",
};

const archNames = siteCopy[zh ? "zh" : "en"].download.archNames;

const assets =
  edition === "desktop"
    ? desktopAssets(release, undefined, "installer")
    : release.assets.filter((asset) => asset.edition === "headless");
---

<div
  data-download-table
  data-edition={edition}
  data-release={JSON.stringify(release)}
  data-labels={JSON.stringify({ os: osNames, arch: archNames })}
>
  <table class="download-table">
    <thead>
      <tr>
        <th>{t.os}</th>
        <th>{t.arch}</th>
        <th>{t.file}</th>
        <th>{t.size}</th>
      </tr>
    </thead>
    <tbody>
      {assets.map((asset) => (
        <tr>
          <td>{osNames[asset.os] ?? asset.os}</td>
          <td>{formatArchitecture(asset, archNames)}</td>
          <td>
            <a
              href={asset.url}
              title={`SHA256: ${asset.sha256}`}
              data-release-asset={asset.name}
            >
              <code>{asset.name}</code>
            </a>
          </td>
          <td>{formatSize(asset.size)}</td>
        </tr>
      ))}
    </tbody>
  </table>

  <p class="download-table__note">
    {t.version}: <code data-release-version>{release.version}</code> ·
    <span data-release-date>{release.publishedAt}</span>
  </p>
</div>

<script>
  import { initDownloadTable } from "../../lib/download-widget";
  document
    .querySelectorAll<HTMLElement>("[data-download-table]")
    .forEach((root) => {
      void initDownloadTable(root);
    });
</script>

<style>
  .download-table :global(code) {
    font-size: var(--sl-text-xs);
  }
  .download-table__note {
    margin-top: -0.5rem;
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-sm);
  }
</style>
