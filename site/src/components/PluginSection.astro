---
import { Code } from "astro:components";
import Icon from "./Icon.astro";
import "../styles/plugin-demo.css";
import {
  defaultAmount,
  defaultMockId,
  demoSecret,
  orderBody,
  signingCode,
  tokenCode,
  mockCode,
  mockScenarios,
} from "../data/plugin-demo";
import { localePath, siteCopy, type Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const { plugins: copy, a11y } = siteCopy[lang].home;
const scenarios = [
  {
    id: "signing",
    fileName: "sign-request.js",
    method: "POST",
    path: "/api/orders",
    sources: [{ id: "signing", code: signingCode }],
  },
  {
    id: "mock",
    fileName: "mock-profile.js",
    method: "GET",
    path: "/api/profile",
    sources: mockScenarios.map((mock) => ({
      id: mock.id,
      code: mockCode(mock),
    })),
  },
  {
    id: "token",
    fileName: "relay-token.js",
    method: "POST",
    path: "/api/login",
    sources: [{ id: "token", code: tokenCode }],
  },
] as const;
---

<section
  id="plugins"
  class="plugins-band frame-section"
  aria-labelledby="plugins-title"
  data-plugin-demo
>
  <div class="frame-inner section-pad">
    <div class="plugins-head">
      <h2 id="plugins-title">{copy.title}</h2>
      <p>{copy.description}</p>
    </div>

    <div class="plugin-frame">
      <div class="plugin-tabbar" role="tablist" aria-label={copy.choose}>
        {scenarios.map((scenario, index) => (
          <button
            type="button"
            role="tab"
            id={`plugin-tab-${scenario.id}`}
            class="scenario-button"
            data-scenario={scenario.id}
            aria-selected={index === 0 ? "true" : "false"}
            aria-controls={`script-${scenario.id}`}
            tabindex={index === 0 ? 0 : -1}
          >
            <Icon name="fileCode" size={14} />
            <code class="mono">{scenario.fileName}</code>
            <span class="scenario-label">{copy.scenarios[scenario.id].label}</span>
          </button>
        ))}
      </div>

      {scenarios.map((scenario, index) => (
        <div
          id={`script-${scenario.id}`}
          role="tabpanel"
          aria-labelledby={`plugin-tab-${scenario.id}`}
          data-scenario-panel={scenario.id}
          hidden={index !== 0}
        >
          <form
            class="plugin-workspace"
            data-demo-flow={scenario.id}
            data-pending={copy.pending}
            data-running={copy.running}
            data-failed={copy.failed}
            data-script-done={copy[scenario.id].done}
          >
            <div class="script-source" data-script-source>
              <div class="source-toolbar">
                <div class="source-file">
                  <code>{scenario.fileName}</code>
                  <span class="script-badge">JavaScript</span>
                </div>
                <button
                  type="button"
                  data-copy-code
                  data-idle={copy.copy}
                  data-done={copy.copied}
                  data-failed={copy.copyManually}
                  data-message-done={a11y.copyDone}
                  data-message-failed={a11y.copyFailed}
                >
                  <Icon name="copy" size={13} />
                  <span>{copy.copy}</span>
                </button>
              </div>
              {scenario.sources.map((source) => (
                <div
                  class="source-code"
                  data-mock-code={scenario.id === "mock" ? source.id : undefined}
                  hidden={scenario.id === "mock" && source.id !== defaultMockId}
                  tabindex="0"
                  role="region"
                  aria-label={scenario.fileName}
                >
                  <Code code={source.code} lang="js" theme="github-dark" />
                </div>
              ))}
              <div class="source-caption">
                <h3>{copy[scenario.id].title}</h3>
                <p>{copy.scenarios[scenario.id].note}</p>
              </div>
            </div>

            <div class="plugin-console">
              <div class="plugin-input">
                <p class="console-label">
                  {scenario.id === "token" ? copy.token.response : copy.input}
                </p>
                <div class="request-title">
                  <span class="method-badge">{scenario.method}</span>
                  <code>{scenario.path}</code>
                </div>
                <p class="console-host mono">api.example.com</p>
                {scenario.id === "signing" && (
                  <>
                    <label class="demo-field">
                      <span>{copy.signing.amount}</span>
                      <input
                        data-amount
                        type="number"
                        min="1"
                        max="99999999"
                        step="1"
                        value={defaultAmount}
                        required
                      />
                    </label>
                    <pre
                      class="input-code"
                      data-order-body
                    >{orderBody(defaultAmount)}</pre>
                    <div class="console-context">
                      <span>{copy.signing.secret}</span>
                      <code>{demoSecret}</code>
                    </div>
                  </>
                )}
                {scenario.id === "mock" && (
                  <>
                    <label class="demo-field">
                      <span>{copy.mock.status}</span>
                      <select data-mock-status>
                        {mockScenarios.map((mock) => (
                          <option
                            value={mock.id}
                            selected={mock.id === defaultMockId}
                          >
                            {mock.status} · {copy.mock.scenarios[mock.id]}
                          </option>
                        ))}
                      </select>
                    </label>
                    <pre class="input-code">Accept: application/json</pre>
                  </>
                )}
                {scenario.id === "token" && (
                  <>
                    <label class="demo-field">
                      <span>{copy.token.value}</span>
                      <input
                        data-token-value
                        type="text"
                        value="sniffy-demo-token"
                        pattern="[A-Za-z0-9._\-]+"
                        maxlength="80"
                        required
                        autocomplete="off"
                        spellcheck="false"
                      />
                    </label>
                    <pre
                      class="input-code"
                      data-login-body
                    >{JSON.stringify({ data: { token: "sniffy-demo-token" } })}</pre>
                  </>
                )}
                <button class="demo-run" type="submit">
                  <Icon name="play" size={14} />
                  {copy.run}
                </button>
              </div>

              <div class="plugin-result">
                <p class="console-label">{copy.output}</p>
                <div class="console-placeholder" data-demo-placeholder>
                  <span class="mono" aria-hidden="true">&gt;_</span>
                  {copy.ready}
                </div>
                <pre class="result-code" data-demo-output hidden></pre>
                {scenario.id === "token" && (
                  <div class="console-context">
                    <span>{copy.token.stored}</span>
                    <code data-stored-token>—</code>
                  </div>
                )}
                <p
                  class="result-status"
                  data-demo-status
                  role="status"
                  aria-live="polite"
                >
                  {copy.pending}
                </p>
              </div>
            </div>
          </form>
        </div>
      ))}

      <div class="demo-under">
        <span>{copy.footnote}</span>
        <a class="text-link" href={localePath(lang, "/docs/plugins/")}>
          {copy.link}
          <Icon name="arrow" size={14} />
        </a>
      </div>
    </div>

    <span
      class="sr-only"
      data-copy-status
      role="status"
      aria-live="polite"
    ></span>
  </div>
</section>

<script>
  import "../scripts/plugin-demo";
</script>
