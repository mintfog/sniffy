---
import Icon from "./Icon.astro";
import PlatformIcon from "./PlatformIcon.astro";
import { localePath, siteCopy, type Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const copy = siteCopy[lang].home.editions;
---

<section
  id="editions"
  class="editions-band frame-section"
  aria-labelledby="editions-title"
>
  <div class="frame-inner section-pad">
    <div class="editions-head">
      <h2 id="editions-title">{copy.title}</h2>
      <p>{copy.description}</p>
    </div>

    <div class="edition-grid">
      <article class="edition-card">
        <div class="edition-title-row">
          <h3>{copy.desktop.title}</h3>
          <span class="edition-tag mono">{copy.desktop.tag}</span>
        </div>
        <p class="edition-text">{copy.desktop.text}</p>
        <ul class="edition-points">
          {copy.desktop.points.map((point) => (
            <li>
              <Icon name="check" size={14} />
              <span>{point}</span>
            </li>
          ))}
        </ul>

        <div class="desktop-matrix">
          <div class="matrix-row">
            <span class="matrix-os">
              <PlatformIcon os="darwin" size={16} />
              <strong>macOS</strong>
            </span>
            <span class="matrix-spec mono">{copy.desktop.matrix.macos}</span>
          </div>
          <div class="matrix-row">
            <span class="matrix-os">
              <PlatformIcon os="windows" size={15} />
              <strong>Windows</strong>
            </span>
            <span class="matrix-spec mono">{copy.desktop.matrix.windows}</span>
          </div>
          <div class="matrix-row">
            <span class="matrix-os">
              <PlatformIcon os="linux" size={17} />
              <strong>Linux</strong>
            </span>
            <span class="matrix-spec mono">{copy.desktop.matrix.linux}</span>
          </div>
        </div>

        <div class="edition-actions">
          <a
            class="button button-small button-primary"
            href={localePath(lang, "/download/")}
          >
            <Icon name="download" size={14} />
            {copy.desktop.cta}
          </a>
          <a class="text-link" href={localePath(lang, "/docs/desktop/")}>
            {copy.desktop.link}
            <Icon name="arrow" size={14} />
          </a>
        </div>
      </article>

      <article class="edition-card">
        <div class="edition-title-row">
          <h3>{copy.headless.title}</h3>
          <span class="edition-tag mono">{copy.headless.tag}</span>
        </div>
        <p class="edition-text">{copy.headless.text}</p>
        <ul class="edition-points">
          {copy.headless.points.map((point) => (
            <li>
              <Icon name="check" size={14} />
              <span>{point}</span>
            </li>
          ))}
        </ul>

        <div class="terminal-box">
          <div class="terminal-head">
            <span class="mono">proxy :8080 · api 127.0.0.1:8888</span>
            <button
              type="button"
              class="copy-command"
              aria-label={copy.copyCommand}
              data-copy-command
              data-label-idle={copy.copyCommand}
              data-label-done={copy.commandCopied}
              data-label-failed={copy.commandCopyFailed}
            >
              <Icon name="copy" size={13} />
            </button>
            <span class="sr-only" data-command-status role="status"></span>
          </div>
          <pre class="terminal-body mono"><code><span class="t-prompt">$</span> <span data-startup-cmd>./sniffy</span>
<span class="t-dim"># proxy :8080 · api 127.0.0.1:8888</span>
<span class="t-prompt">$</span> curl -H "Authorization: Bearer $SNIFFY_API_TOKEN" \
  <span class="t-url">http://127.0.0.1:8888/api/sessions</span></code></pre>
        </div>

        <div class="edition-actions">
          <a class="text-link" href={localePath(lang, "/docs/headless/")}>
            {copy.headless.link}
            <Icon name="arrow" size={14} />
          </a>
          <a class="text-link" href={localePath(lang, "/docs/api/")}>
            {copy.headless.apiLink}
            <Icon name="arrow" size={14} />
          </a>
        </div>
      </article>
    </div>
  </div>
</section>

<script>
  import { copyText } from "../lib/clipboard";

  const button = document.querySelector<HTMLButtonElement>(
    "[data-copy-command]",
  )!;
  const status = document.querySelector<HTMLElement>("[data-command-status]")!;
  const command = document.querySelector<HTMLElement>("[data-startup-cmd]")!;
  let resetTimer: number | undefined;
  button.addEventListener("click", async () => {
    window.clearTimeout(resetTimer);
    if (await copyText(command)) {
      button.setAttribute("aria-label", button.dataset.labelDone!);
      button.dataset.copied = "true";
      status.textContent = button.dataset.labelDone!;
    } else {
      status.textContent = button.dataset.labelFailed!;
    }
    resetTimer = window.setTimeout(() => {
      button.setAttribute("aria-label", button.dataset.labelIdle!);
      delete button.dataset.copied;
    }, 2200);
  });
</script>

<style>
  .editions-band {
    background: var(--surface-subtle);
  }
  .editions-head {
    max-width: 680px;
    margin-bottom: 32px;
  }
  .editions-head p {
    margin-top: 10px;
    font-size: 15.5px;
    color: var(--muted);
    line-height: 1.7;
  }

  .edition-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
  }
  .edition-card {
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: 26px;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--surface);
  }
  .edition-title-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 8px 12px;
  }
  .edition-card h3 {
    font-size: 19px;
    font-weight: 650;
  }
  .edition-tag {
    font-size: 11.5px;
    color: var(--faint);
  }
  .edition-text {
    margin-top: 10px;
    font-size: 14px;
    line-height: 1.7;
    color: var(--muted);
  }
  .edition-points {
    list-style: none;
    margin: 18px 0 0;
    padding: 0;
    display: grid;
    gap: 9px;
  }
  .edition-points li {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    font-size: 13.5px;
    line-height: 1.55;
    color: var(--ink);
  }
  .edition-points li :global(svg) {
    margin-top: 3px;
    color: var(--accent);
  }

  .desktop-matrix {
    margin-top: 22px;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--surface-subtle);
    overflow: hidden;
  }
  .matrix-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 11px 14px;
    border-bottom: 1px solid var(--line);
    font-size: 13px;
  }
  .matrix-row:last-child {
    border-bottom: 0;
  }
  .matrix-os {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--ink);
    flex-shrink: 0;
  }
  .matrix-os strong {
    font-weight: 600;
  }
  .matrix-spec {
    color: var(--muted);
    font-size: 11.5px;
    text-align: right;
  }

  .terminal-box {
    margin-top: 22px;
    border: 1px solid var(--code-line);
    border-radius: 8px;
    background: var(--code-bg);
    overflow: hidden;
  }
  .terminal-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding: 8px 12px;
    border-bottom: 1px solid var(--code-line);
    background: var(--code-surface);
    color: var(--code-muted);
    font-size: 11.5px;
  }
  .copy-command {
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    border: 1px solid var(--code-line);
    border-radius: 5px;
    background: transparent;
    color: var(--code-muted);
    transition:
      background-color 140ms ease,
      color 140ms ease;
  }
  .copy-command:hover,
  .copy-command[data-copied] {
    color: #93c5fd;
    border-color: rgb(147 197 253 / 35%);
    background: rgb(147 197 253 / 10%);
  }
  .copy-command[data-copied] :global(svg) {
    display: none;
  }
  .copy-command[data-copied]::after {
    content: "✓";
    font-size: 12px;
    font-weight: 700;
  }
  .terminal-body {
    margin: 0;
    padding: 13px 15px;
    font-size: 12px;
    line-height: 1.75;
    color: var(--code-fg);
    overflow-x: auto;
  }
  .t-prompt {
    color: #60a5fa;
    user-select: none;
  }
  .t-dim {
    color: #64748b;
  }
  .t-url {
    color: #93c5fd;
  }

  .edition-actions {
    margin-top: auto;
    padding-top: 20px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px 20px;
  }

  @media (max-width: 920px) {
    .edition-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 640px) {
    .editions-head p {
      font-size: 14.5px;
    }
    .edition-card {
      padding: 20px 18px;
    }
  }
</style>
