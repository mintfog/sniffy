---
import Icon from "./Icon.astro";
import WorkbenchPreview from "./WorkbenchPreview.astro";
import { localePath, siteCopy, type Lang } from "../i18n/ui";
import { repository } from "../data/repository";
import { buildStarLabel } from "../data/stars";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const copy = siteCopy[lang].home.hero;
---

<section class="hero frame-section" aria-labelledby="hero-title">
  <div class="frame-inner hero-inner">
    <div class="hero-header">
      <p class="hero-meta mono">{copy.metaLine}</p>
      <h1 id="hero-title" class:list={{ "hero-title-stacked": !copy.titleAfter }}>
        <span>{copy.titleBefore}</span><span
          class="title-slot"
          data-title-rotator
          data-words={JSON.stringify(copy.titleRotate.slice(1))}
        ><span class="title-slot-word" data-slot-state="active"
          >{copy.titleRotate[0]}</span></span>{copy.titleAfter && <span>{copy.titleAfter}</span>}
      </h1>
      <p class="hero-description">
        {copy.description.map((line, index) => (
          <span class="hero-desc-line">
            {index > 0 && lang === "en" ? " " : ""}
            {line}
          </span>
        ))}
      </p>

      <div class="hero-actions">
        <a
          id="download"
          class="button button-primary"
          href={localePath(lang, "/download/")}
        >
          <Icon name="download" size={16} />
          {copy.download}
        </a>
        <a
          class="button button-outline hero-star"
          href={repository}
          target="_blank"
          rel="noopener noreferrer"
        >
          <Icon name="star" size={15} class="hero-star-icon" />
          <span>{copy.starCta}</span>
          <span class="hero-star-count mono" data-github-stars hidden={!buildStarLabel}>{buildStarLabel}</span>
        </a>
        <a class="hero-docs-link" href={localePath(lang, "/docs/")}>
          {copy.readDocs}
          <Icon name="arrow" size={15} />
        </a>
      </div>
    </div>

    <div class="workbench-stage">
      <ul class="protocol-inline mono" aria-label={copy.protocolsLabel}>
        {copy.protocols.map((proto) => (
          <li>{proto}</li>
        ))}
      </ul>
      <WorkbenchPreview lang={lang} />
      <p class="stage-footnote">{copy.footnote}</p>
    </div>
  </div>
</section>

<script>
  const rotator = document.querySelector<HTMLElement>("[data-title-rotator]");
  if (rotator) {
    // 其余轮播词只在浏览器里补上，静态 HTML 的 h1 保持一句完整标题供搜索引擎读取；
    // 克隆首个词是为了带上组件样式的作用域标记。
    const first = rotator.querySelector<HTMLElement>(".title-slot-word")!;
    for (const word of JSON.parse(rotator.dataset.words ?? "[]") as string[]) {
      const span = first.cloneNode() as HTMLElement;
      span.dataset.slotState = "waiting";
      span.setAttribute("aria-hidden", "true");
      span.textContent = word;
      rotator.append(span);
    }
    const words = [
      ...rotator.querySelectorAll<HTMLElement>(".title-slot-word"),
    ];
    const heading = rotator.closest("h1");
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

    if (words.length > 1) {
      let current = 0;
      let timer: number | undefined;
      let cleanupTimer: number | undefined;
      let paused = false;

      const step = () => {
        if (paused || document.hidden || reducedMotion.matches) return;
        window.clearTimeout(cleanupTimer);
        words.forEach((el, idx) => {
          if (idx !== current) el.dataset.slotState = "waiting";
        });
        const prev = words[current];
        const nextIndex = (current + 1) % words.length;
        const next = words[nextIndex];
        prev.dataset.slotState = "exiting";
        // 读取布局确保 waiting 状态已落位，再切到 active 触发入场过渡
        void next.offsetHeight;
        next.dataset.slotState = "active";
        current = nextIndex;
        cleanupTimer = window.setTimeout(() => {
          if (prev.dataset.slotState === "exiting") {
            prev.dataset.slotState = "waiting";
          }
        }, 340);
      };

      const start = () => {
        if (timer !== undefined || reducedMotion.matches) return;
        timer = window.setInterval(step, 2000);
      };

      const stop = () => {
        window.clearInterval(timer);
        timer = undefined;
      };

      heading?.addEventListener("mouseenter", () => {
        paused = true;
      });
      heading?.addEventListener("mouseleave", () => {
        paused = false;
      });
      document.addEventListener("visibilitychange", () => {
        if (document.hidden) stop();
        else start();
      });
      reducedMotion.addEventListener("change", (event) => {
        if (event.matches) {
          stop();
          window.clearTimeout(cleanupTimer);
          current = 0;
          words.forEach((el, idx) => {
            el.dataset.slotState = idx === 0 ? "active" : "waiting";
          });
        } else {
          start();
        }
      });

      start();
    }
  }
</script>

<style>
  .hero {
    background: linear-gradient(180deg, #ffffff 0%, #f7f9fc 100%);
  }
  .hero-inner {
    padding-top: 56px;
    padding-bottom: 56px;
  }
  .hero-header {
    max-width: 780px;
    margin-inline: auto;
    text-align: center;
  }
  .hero-meta {
    font-size: 12.5px;
    color: var(--faint);
    letter-spacing: 0.01em;
  }
  .hero h1 {
    margin-top: 14px;
    font-size: clamp(32px, 4.4vw, 48px);
    font-weight: 700;
    line-height: 1.16;
    letter-spacing: -0.03em;
    color: var(--ink);
  }
  :global(html[lang="en"]) .hero h1 {
    font-size: clamp(34px, 4.4vw, 50px);
    line-height: 1.12;
    letter-spacing: -0.035em;
  }
  .title-slot {
    display: inline-grid;
    vertical-align: baseline;
    padding-block: 0.14em;
    margin-block: -0.14em;
    overflow-y: clip;
    overflow-x: visible;
    color: var(--accent);
  }
  .hero-title-stacked .title-slot {
    display: grid;
    justify-items: center;
    margin-top: 0.04em;
  }
  .title-slot-word {
    grid-area: 1 / 1;
    white-space: nowrap;
    transition:
      transform 300ms cubic-bezier(0.22, 1, 0.36, 1),
      opacity 240ms ease;
  }
  .title-slot-word[data-slot-state="active"] {
    opacity: 1;
    transform: translateY(0);
  }
  .title-slot-word[data-slot-state="exiting"] {
    opacity: 0;
    transform: translateY(-62%);
    pointer-events: none;
  }
  .title-slot-word[data-slot-state="waiting"] {
    opacity: 0;
    transform: translateY(62%);
    transition: none;
    pointer-events: none;
  }
  .hero-description {
    margin: 16px auto 0;
    max-width: 760px;
    font-size: 16px;
    line-height: 1.72;
    color: var(--muted);
  }
  .hero-desc-line {
    display: block;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 10px 12px;
    margin-top: 24px;
  }
  .hero-star {
    gap: 7px;
  }
  .hero-star :global(.hero-star-icon) {
    color: var(--star);
    transition: transform 150ms ease;
  }
  .hero-star:hover :global(.hero-star-icon) {
    transform: scale(1.1);
    fill: var(--star);
  }
  .hero-star-count {
    padding-left: 8px;
    margin-left: 2px;
    border-left: 1px solid var(--line);
    color: var(--muted);
    font-size: 12.5px;
    font-weight: 500;
  }
  .hero-docs-link {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 8px 10px;
    font-size: 14px;
    font-weight: 550;
    color: var(--accent);
  }
  .hero-docs-link:hover {
    color: var(--accent-hover);
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .workbench-stage {
    margin-top: 34px;
  }
  .protocol-inline {
    list-style: none;
    margin: 0 0 14px;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 6px 14px;
    font-size: 12px;
    color: var(--muted);
  }
  .protocol-inline li {
    position: relative;
  }
  .protocol-inline li:not(:last-child)::after {
    content: "·";
    margin-left: 14px;
    color: var(--line-strong);
  }
  .stage-footnote {
    margin-top: 12px;
    text-align: center;
    font-size: 12.5px;
    color: var(--faint);
    line-height: 1.6;
  }

  @media (max-width: 760px) {
    .hero-inner {
      padding-top: 32px;
      padding-bottom: 42px;
    }
    .hero h1 {
      font-size: clamp(23px, 6.2vw, 34px);
    }
    .hero-description {
      font-size: 14.5px;
    }
    .hero-desc-line {
      display: inline;
    }
    .hero-actions {
      margin-top: 20px;
    }
    .workbench-stage {
      margin-top: 26px;
    }
    .protocol-inline {
      font-size: 11.5px;
      gap: 4px 10px;
    }
    .protocol-inline li:not(:last-child)::after {
      margin-left: 10px;
    }
  }
</style>
