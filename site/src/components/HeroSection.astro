---
import Icon from "./Icon.astro";
import Lines from "./Lines.astro";
import PlatformList from "./PlatformList.astro";
import TrafficTrace from "./TrafficTrace.astro";
import WorkbenchPreview from "./WorkbenchPreview.astro";
import { localePath, siteCopy, type Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const copy = siteCopy[lang].home.hero;
---

<section class="hero" aria-labelledby="hero-title">
  <div class="container">
    <div class="hero-intro">
      <div class="hero-copy">
        <p class="hero-eyebrow mono" data-reveal>
          <span class="status-dot"></span>
          {copy.eyebrow}
        </p>
        <h1 id="hero-title" data-reveal data-reveal-delay="60">
          {copy.title.lead}
          <br />
          <span>{copy.title.highlight}</span>
        </h1>
        <p class="hero-description" data-reveal data-reveal-delay="120">
          <Lines lines={copy.description} />
        </p>
        <div class="hero-actions" data-reveal data-reveal-delay="180">
          <a
            id="download"
            class="button button-primary"
            href={localePath(lang, "/download/")}
          >
            {copy.download}
            <Icon name="download" size={17} />
          </a>
          <a class="hero-docs" href={localePath(lang, "/docs/")}>
            {copy.readDocs}
            <Icon name="arrow" size={17} />
          </a>
        </div>
        <p class="platform-line" data-reveal data-reveal-delay="240">
          <PlatformList variant="hero" />
          <i></i>
          <span class="platform-license">{copy.license}</span>
        </p>
      </div>
      <TrafficTrace lang={lang} />
    </div>
    <div class="preview-wrap" data-reveal>
      <div class="preview-caption">
        <span class="mono">{copy.previewLeft}</span>
        <span>
          <span class="status-dot"></span>
          {copy.previewRight}
        </span>
      </div>
      <div class="preview-stage">
        <WorkbenchPreview lang={lang} />
      </div>
      <div class="preview-footnote">
        <span>{copy.footnote}</span>
        <span class="mono">{copy.footnoteMono}</span>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-top: 64px;
    overflow: clip;
  }
  .hero-intro {
    display: grid;
    grid-template-columns: 1.12fr 1fr;
    align-items: center;
    min-height: 470px;
    padding: 0 24px 56px;
  }
  .hero-copy {
    position: relative;
    z-index: 1;
  }
  .hero-eyebrow {
    display: flex;
    align-items: center;
    gap: 13px;
    font-size: 12px;
    letter-spacing: 2px;
    color: var(--muted);
  }
  .hero h1 {
    margin: 30px 0 22px;
    font-size: clamp(46px, 6.5vw, 78px);
    font-weight: 700;
    line-height: 1.24;
    letter-spacing: -3px;
  }
  .hero h1 > span {
    color: var(--teal);
  }
  :global(html[lang="en"]) .hero h1 {
    font-size: clamp(46px, 6.1vw, 78px);
    letter-spacing: -3px;
    line-height: 1.08;
  }
  .hero-description {
    font-size: 17px;
    line-height: 1.8;
    color: var(--muted);
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 30px;
    margin-top: 26px;
  }
  .hero-docs {
    display: inline-flex;
    align-items: center;
    gap: 13px;
    color: var(--teal);
    font-size: 14px;
    font-weight: 600;
    padding-block: 14px;
    min-height: 52px;
  }
  .hero-docs:hover {
    text-decoration: underline;
    text-underline-offset: 5px;
  }
  .platform-line {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 20px;
    margin-top: 28px;
    color: var(--muted);
    font-size: 11px;
  }
  .platform-line > i {
    width: 1px;
    height: 12px;
    background: var(--line);
  }
  .preview-wrap {
    padding: 26px 22px 0;
    border-radius: 14px;
    background: linear-gradient(125deg, #edf7f3, #f0f8f5 60%, #eaf6f1);
  }
  .preview-caption {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
    padding: 0 8px 22px;
    color: var(--muted);
    font-size: 11px;
  }
  .preview-caption > span {
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }
  .preview-caption .mono {
    letter-spacing: 2px;
  }
  .preview-caption .status-dot {
    width: 5px;
    height: 5px;
  }
  .preview-stage {
    position: relative;
    min-width: 0;
  }
  .preview-stage :global(.workbench) {
    box-shadow:
      0 12px 32px #24473d12,
      0 2px 8px #24473d09;
    border-color: #e1e5d9;
  }
  .preview-footnote {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 32px 8px;
    color: var(--ink);
    font-size: 16px;
    font-weight: 500;
  }
  .preview-footnote .mono {
    color: var(--muted);
    font-size: 9px;
    font-weight: 400;
    letter-spacing: 1.8px;
  }
  @media (max-width: 1100px) {
    .hero-intro {
      padding-inline: 24px 0;
    }
    .hero h1 {
      letter-spacing: -2px;
    }
    .hero-description {
      font-size: 16px;
    }
    .platform-line {
      gap: 14px;
    }
    .preview-footnote {
      font-size: 14px;
    }
  }
  @media (max-width: 760px) {
    .hero {
      padding-top: 42px;
    }
    .hero-intro {
      grid-template-columns: minmax(0, 1fr);
      padding: 0 4px 30px;
    }
    .hero h1 {
      font-size: clamp(35px, 8.5vw, 60px);
      letter-spacing: -1.5px;
      margin-block: 24px 20px;
    }
    :global(html[lang="en"]) .hero h1 {
      font-size: clamp(42px, 10vw, 68px);
      letter-spacing: -2px;
    }
    .hero-eyebrow {
      font-size: 11px;
      letter-spacing: 1.5px;
    }
    .hero-description {
      font-size: 14px;
    }
    .hero-description :global(br) {
      display: none;
    }
    .hero-actions {
      gap: 22px;
    }
    .platform-line {
      font-size: 10px;
      gap: 14px;
      margin-top: 24px;
    }
    .platform-line > i {
      display: none;
    }
    .platform-license {
      flex-basis: 100%;
    }
    .preview-wrap {
      padding: 18px 8px 0;
      border-radius: 10px;
    }
    .preview-caption {
      padding: 0 5px 15px;
      font-size: 10px;
      gap: 8px;
    }
    .preview-caption .mono {
      letter-spacing: 1px;
    }
    .preview-caption > span {
      gap: 5px;
    }
    .preview-footnote {
      padding: 22px 6px;
      font-size: 12px;
      line-height: 1.7;
    }
    .preview-footnote .mono {
      display: none;
    }
  }
</style>
