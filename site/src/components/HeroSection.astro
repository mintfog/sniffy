---
import Icon from "./Icon.astro";
import PlatformIcon from "./PlatformIcon.astro";
import WorkbenchPreview from "./WorkbenchPreview.astro";
import { localePath, siteCopy, type Lang } from "../i18n/ui";
import { release } from "../data/release";
import { pageRelease } from "../lib/downloads";
import {
  formatHeroOptionTitle,
  heroDropdownAssets,
} from "../lib/download-widget";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const copy = siteCopy[lang].home.hero;
const downloadCopy = siteCopy[lang].download;
const downloadPath = localePath(lang, "/download/");
const menuAssets = heroDropdownAssets(release);
---

<section class="hero frame-section" aria-labelledby="hero-title">
  <div class="frame-inner hero-inner">
    <div class="hero-header">
      <p class="hero-meta mono">{copy.metaLine}</p>
      <h1 id="hero-title" class:list={{ "hero-title-stacked": !copy.titleAfter }}>
        <span>{copy.titleBefore}</span>{
          copy.titleAfter ? (
            <span class="title-tail"><span
              class="title-slot"
              data-title-rotator
              data-words={JSON.stringify(copy.titleRotate.slice(1))}
            ><span class="title-slot-word" data-slot-state="active"
              >{copy.titleRotate[0]}</span></span><span>{copy.titleAfter}</span></span>
          ) : (
            <span
              class="title-slot"
              data-title-rotator
              data-words={JSON.stringify(copy.titleRotate.slice(1))}
            ><span class="title-slot-word" data-slot-state="active"
              >{copy.titleRotate[0]}</span></span>
          )
        }
      </h1>
      <p class="hero-description">
        {copy.description.map((line, index) => (
          <span class="hero-desc-line">
            {index > 0 && lang === "en" ? " " : ""}
            {line}
          </span>
        ))}
      </p>

      <div
        class="hero-actions"
        data-hero-download-root
        data-release={JSON.stringify(pageRelease(release))}
        data-copy={JSON.stringify(downloadCopy)}
        data-download-page={downloadPath}
        data-default-sub={copy.defaultSub}
        data-option-prefix={copy.optionPrefix}
        data-windows-name={copy.windowsName}
      >
        <div class="hero-dl-control" data-hero-dl-control>
          <div class="hero-install-pill">
            <a
              id="download"
              class="hero-install-primary"
              href={downloadPath}
              data-hero-dl-link
            >
              <span class="hero-install-icon" data-hero-btn-icon="default">
                <PlatformIcon os="download" size={26} onDark />
              </span>
              <span
                class="hero-install-icon"
                data-hero-btn-icon="darwin"
                hidden
              >
                <PlatformIcon os="darwin" size={27} onDark />
              </span>
              <span
                class="hero-install-icon"
                data-hero-btn-icon="windows"
                hidden
              >
                <PlatformIcon os="windows" size={26} onDark />
              </span>
              <span class="hero-install-icon" data-hero-btn-icon="linux" hidden>
                <PlatformIcon os="linux" size={28} onDark />
              </span>
              <span class="hero-install-copy">
                <strong class="hero-install-title">{copy.download}</strong>
                <span class="hero-install-sub" data-hero-dl-sub>
                  {copy.defaultSub}
                </span>
              </span>
            </a>
            <button
              type="button"
              class="hero-install-toggle"
              aria-label={copy.moreDownloads}
              aria-haspopup="menu"
              aria-expanded="false"
              aria-controls="hero-download-menu"
              data-hero-dl-toggle
            >
              <Icon name="caret" size={20} stroke={2.25} />
            </button>
          </div>

          <div
            class="hero-dl-menu"
            id="hero-download-menu"
            role="menu"
            aria-label={copy.moreDownloads}
            data-hero-dl-menu
            hidden
          >
            <div class="hero-dl-list" data-hero-menu-options>
              {menuAssets.map((asset) => (
                <a
                  class="hero-dl-option"
                  role="menuitem"
                  tabindex="-1"
                  href={asset.url}
                  data-release-asset={asset.name}
                  data-hero-dl-choice
                  data-hero-menu-item
                >
                  <span
                    class="hero-option-os"
                    data-option-icon="darwin"
                    hidden={asset.os !== "darwin"}
                  >
                    <PlatformIcon os="darwin" size={21} />
                  </span>
                  <span
                    class="hero-option-os"
                    data-option-icon="windows"
                    hidden={asset.os !== "windows"}
                  >
                    <PlatformIcon os="windows" size={20} />
                  </span>
                  <span
                    class="hero-option-os"
                    data-option-icon="linux"
                    hidden={asset.os !== "linux"}
                  >
                    <PlatformIcon os="linux" size={22} />
                  </span>
                  <span class="hero-option-title" data-option-title>
                    {formatHeroOptionTitle(asset, downloadCopy, {
                      prefix: copy.optionPrefix,
                      windowsName: copy.windowsName,
                    })}
                  </span>
                  <span class="hero-option-action" aria-hidden="true">
                    <Icon name="download" size={16} />
                  </span>
                </a>
              ))}
            </div>
            <div class="hero-dl-footer">
              <a
                class="hero-dl-more"
                role="menuitem"
                tabindex="-1"
                href={downloadPath}
                data-hero-more-link
                data-hero-menu-item
              >
                <span class="hero-more-copy">
                  <strong>{copy.allDownloads}</strong>
                  <span>{copy.allDownloadsSub}</span>
                </span>
                <Icon name="arrow" size={15} />
              </a>
            </div>
          </div>

          <template data-hero-option-template>
            <a
              class="hero-dl-option"
              role="menuitem"
              tabindex="-1"
              data-hero-dl-choice
              data-hero-menu-item
            >
              <span class="hero-option-os" data-option-icon="darwin" hidden>
                <PlatformIcon os="darwin" size={21} />
              </span>
              <span class="hero-option-os" data-option-icon="windows" hidden>
                <PlatformIcon os="windows" size={20} />
              </span>
              <span class="hero-option-os" data-option-icon="linux" hidden>
                <PlatformIcon os="linux" size={22} />
              </span>
              <span class="hero-option-title" data-option-title></span>
              <span class="hero-option-action" aria-hidden="true">
                <Icon name="download" size={16} />
              </span>
            </a>
          </template>
        </div>
      </div>
    </div>

    <div class="workbench-stage">
      <ul class="protocol-inline mono" aria-label={copy.protocolsLabel}>
        {copy.protocols.map((proto) => (
          <li>{proto}</li>
        ))}
      </ul>
      <WorkbenchPreview lang={lang} />
      <p class="stage-footnote">{copy.footnote}</p>
    </div>
  </div>
</section>

<script>
  import { initHeroDownload } from "../lib/download-widget";

  const heroDownload = document.querySelector<HTMLElement>(
    "[data-hero-download-root]",
  );
  if (heroDownload) {
    void initHeroDownload(heroDownload);
  }

  const rotator = document.querySelector<HTMLElement>("[data-title-rotator]");
  if (rotator) {
    // 其余轮播词只在浏览器里补上，静态 HTML 的 h1 保持一句完整标题供搜索引擎读取；
    // 克隆首个词是为了带上组件样式的作用域标记。
    const first = rotator.querySelector<HTMLElement>(".title-slot-word")!;
    for (const word of JSON.parse(rotator.dataset.words ?? "[]") as string[]) {
      const span = first.cloneNode() as HTMLElement;
      span.dataset.slotState = "waiting";
      span.setAttribute("aria-hidden", "true");
      span.textContent = word;
      rotator.append(span);
    }
    const words = [
      ...rotator.querySelectorAll<HTMLElement>(".title-slot-word"),
    ];
    const heading = rotator.closest("h1");
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

    if (words.length > 1) {
      let current = 0;
      let timer: number | undefined;
      let cleanupTimer: number | undefined;
      let paused = false;

      const step = () => {
        if (paused || document.hidden || reducedMotion.matches) return;
        window.clearTimeout(cleanupTimer);
        words.forEach((el, idx) => {
          if (idx !== current) el.dataset.slotState = "waiting";
        });
        const prev = words[current];
        const nextIndex = (current + 1) % words.length;
        const next = words[nextIndex];
        prev.dataset.slotState = "exiting";
        // 读取布局确保 waiting 状态已落位，再切到 active 触发入场过渡
        void next.offsetHeight;
        next.dataset.slotState = "active";
        current = nextIndex;
        cleanupTimer = window.setTimeout(() => {
          if (prev.dataset.slotState === "exiting") {
            prev.dataset.slotState = "waiting";
          }
        }, 340);
      };

      const start = () => {
        if (timer !== undefined || reducedMotion.matches) return;
        timer = window.setInterval(step, 2000);
      };

      const stop = () => {
        window.clearInterval(timer);
        timer = undefined;
      };

      heading?.addEventListener("mouseenter", () => {
        paused = true;
      });
      heading?.addEventListener("mouseleave", () => {
        paused = false;
      });
      document.addEventListener("visibilitychange", () => {
        if (document.hidden) stop();
        else start();
      });
      reducedMotion.addEventListener("change", (event) => {
        if (event.matches) {
          stop();
          window.clearTimeout(cleanupTimer);
          current = 0;
          words.forEach((el, idx) => {
            el.dataset.slotState = idx === 0 ? "active" : "waiting";
          });
        } else {
          start();
        }
      });

      start();
    }
  }
</script>

<style>
  .hero {
    background: linear-gradient(180deg, #ffffff 0%, #f7f9fc 100%);
  }
  .hero-inner {
    padding-top: 56px;
    padding-bottom: 56px;
  }
  .hero-header {
    max-width: 780px;
    margin-inline: auto;
    text-align: center;
  }
  .hero-meta {
    font-size: 12.5px;
    color: var(--faint);
    letter-spacing: 0.01em;
  }
  .hero h1 {
    margin-top: 14px;
    font-size: clamp(32px, 4.4vw, 48px);
    font-weight: 700;
    line-height: 1.16;
    letter-spacing: -0.03em;
    color: var(--ink);
    text-wrap: balance;
  }
  :global(html[lang="en"]) .hero h1 {
    font-size: clamp(34px, 4.4vw, 50px);
    line-height: 1.12;
    letter-spacing: -0.035em;
  }
  .title-tail {
    white-space: nowrap;
  }
  .title-slot {
    display: inline-grid;
    vertical-align: baseline;
    padding-block: 0.14em;
    margin-block: -0.14em;
    overflow-y: clip;
    overflow-x: visible;
    color: var(--accent);
  }
  .hero-title-stacked .title-slot {
    display: grid;
    justify-items: center;
    margin-top: 0.04em;
  }
  .title-slot-word {
    grid-area: 1 / 1;
    white-space: nowrap;
    transition:
      transform 300ms cubic-bezier(0.22, 1, 0.36, 1),
      opacity 240ms ease;
  }
  .title-slot-word[data-slot-state="active"] {
    opacity: 1;
    transform: translateY(0);
  }
  .title-slot-word[data-slot-state="exiting"] {
    opacity: 0;
    transform: translateY(-62%);
    pointer-events: none;
  }
  .title-slot-word[data-slot-state="waiting"] {
    opacity: 0;
    transform: translateY(62%);
    transition: none;
    pointer-events: none;
  }
  .hero-description {
    margin: 16px auto 0;
    max-width: 760px;
    font-size: 16px;
    line-height: 1.72;
    color: var(--muted);
  }
  .hero-desc-line {
    display: block;
  }

  .hero-actions {
    display: flex;
    justify-content: center;
    margin-top: 28px;
  }
  .hero-dl-control {
    position: relative;
  }
  .hero-install-pill {
    display: inline-flex;
    align-items: stretch;
    min-width: 332px;
    min-height: 64px;
    border-radius: 9999px;
    background: var(--btn-bg);
    color: var(--btn-fg);
    box-shadow:
      0 1px 0 rgb(255 255 255 / 12%) inset,
      0 10px 26px -6px rgb(15 23 42 / 26%),
      0 2px 6px rgb(15 23 42 / 10%);
    transition:
      box-shadow 180ms ease,
      transform 180ms ease;
  }
  .hero-install-pill:hover {
    box-shadow:
      0 1px 0 rgb(255 255 255 / 14%) inset,
      0 14px 32px -6px rgb(15 23 42 / 32%),
      0 4px 10px rgb(15 23 42 / 12%);
  }
  .hero-install-primary {
    flex: 1;
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 10px 20px 10px 24px;
    border-radius: 9999px 0 0 9999px;
    text-align: left;
    color: #ffffff;
    transition: background-color 150ms ease;
  }
  .hero-install-primary:hover {
    background: rgb(255 255 255 / 8%);
  }
  .hero-install-primary[aria-busy="true"] {
    opacity: 0.78;
    cursor: progress;
  }
  .hero-install-icon {
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    color: #ffffff;
  }
  .hero-install-copy {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }
  .hero-install-title {
    font-size: 16.5px;
    font-weight: 700;
    line-height: 1.22;
    letter-spacing: -0.015em;
    color: #ffffff;
  }
  .hero-install-sub {
    font-size: 12.5px;
    font-weight: 450;
    line-height: 1.3;
    color: #cbd5e1;
    white-space: nowrap;
  }
  .hero-install-toggle {
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    padding: 0;
    border: 0;
    border-left: 1px solid rgb(255 255 255 / 28%);
    border-radius: 0 9999px 9999px 0;
    background: rgb(255 255 255 / 6%);
    color: #ffffff;
    transition:
      background-color 150ms ease,
      border-color 150ms ease;
  }
  .hero-install-toggle:hover,
  .hero-install-toggle[aria-expanded="true"] {
    background: rgb(255 255 255 / 15%);
    border-left-color: rgb(255 255 255 / 38%);
  }
  .hero-install-toggle :global(svg) {
    transition: transform 180ms ease;
  }
  .hero-install-toggle[aria-expanded="true"] :global(svg) {
    transform: rotate(180deg);
  }
  .hero-install-primary:focus-visible,
  .hero-install-toggle:focus-visible {
    outline-offset: 3px;
  }

  .hero-dl-menu {
    position: absolute;
    top: calc(100% + 10px);
    left: 50%;
    transform: translateX(-50%);
    z-index: 25;
    width: 384px;
    max-width: calc(100vw - 32px);
    padding: 8px;
    border: 1px solid var(--line-strong);
    border-radius: 14px;
    background: var(--surface);
    box-shadow:
      0 24px 54px -12px rgb(15 23 42 / 32%),
      0 4px 16px rgb(15 23 42 / 10%);
    text-align: left;
  }
  .hero-dl-list {
    display: grid;
    gap: 2px;
  }
  .hero-dl-option {
    display: flex;
    align-items: center;
    gap: 13px;
    min-height: 48px;
    padding: 10px 14px;
    border-radius: 10px;
    color: var(--ink);
    transition:
      background-color 120ms ease,
      color 120ms ease;
  }
  .hero-dl-option:hover,
  .hero-dl-option:focus-visible {
    background: var(--surface-subtle);
  }
  .hero-dl-option:focus-visible,
  .hero-dl-more:focus-visible {
    outline-offset: -2px;
  }
  .hero-option-os {
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    color: var(--ink);
  }
  .hero-option-title {
    font-size: 14.5px;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--ink);
  }
  .hero-option-action {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    color: var(--muted);
    transition:
      color 120ms ease,
      transform 120ms ease;
  }
  .hero-dl-option:hover .hero-option-action,
  .hero-dl-option:focus-visible .hero-option-action {
    color: var(--accent);
    transform: translateY(1px);
  }
  .hero-dl-footer {
    margin-top: 6px;
    padding-top: 6px;
    border-top: 1px solid var(--line);
  }
  .hero-dl-more {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 10px 14px;
    border-radius: 10px;
    color: var(--ink);
    transition: background-color 120ms ease;
  }
  .hero-dl-more:hover,
  .hero-dl-more:focus-visible {
    background: var(--surface-subtle);
  }
  .hero-more-copy {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .hero-more-copy strong {
    font-size: 13.5px;
    font-weight: 600;
    color: var(--ink);
  }
  .hero-more-copy span {
    font-size: 12px;
    color: var(--muted);
  }
  .hero-dl-more :global(svg) {
    flex: none;
    color: var(--muted);
    transition:
      color 120ms ease,
      transform 120ms ease;
  }
  .hero-dl-more:hover :global(svg),
  .hero-dl-more:focus-visible :global(svg) {
    color: var(--accent);
    transform: translateX(2px);
  }

  .workbench-stage {
    margin-top: 34px;
  }
  .protocol-inline {
    list-style: none;
    margin: 0 0 14px;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 6px 14px;
    font-size: 12px;
    color: var(--muted);
  }
  .protocol-inline li {
    position: relative;
  }
  .protocol-inline li:not(:last-child)::after {
    content: "·";
    margin-left: 14px;
    color: var(--line-strong);
  }
  .stage-footnote {
    margin-top: 12px;
    text-align: center;
    font-size: 12.5px;
    color: var(--faint);
    line-height: 1.6;
  }

  @media (max-width: 760px) {
    .hero-inner {
      padding-top: 32px;
      padding-bottom: 42px;
    }
    .hero h1 {
      font-size: clamp(23px, 6.2vw, 34px);
    }
    .hero-description {
      font-size: 14.5px;
    }
    .hero-desc-line {
      display: inline;
    }
    .hero-actions {
      margin-top: 22px;
    }
    .hero-install-pill {
      min-width: min(316px, calc(100vw - 36px));
      min-height: 60px;
    }
    .hero-install-primary {
      padding: 9px 16px 9px 20px;
      gap: 12px;
    }
    .hero-install-title {
      font-size: 15.5px;
    }
    .hero-install-toggle {
      width: 48px;
    }
    .workbench-stage {
      margin-top: 26px;
    }
    .protocol-inline {
      font-size: 11.5px;
      gap: 4px 10px;
    }
    .protocol-inline li:not(:last-child)::after {
      margin-left: 10px;
    }
  }
</style>
