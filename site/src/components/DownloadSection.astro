---
import Icon from "./Icon.astro";
import Lines from "./Lines.astro";
import { localePath, siteCopy, type Lang } from "../i18n/ui";
import {
  desktopDownloads,
  formatSize,
  type ReleaseAsset,
} from "../data/release";
import type { IconName } from "./icons";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const copy = siteCopy[lang].home.download;

const preferred: Record<string, string> = { darwin: "arm64" };

function platform(
  os: string,
  icon: IconName,
  iconSize: number,
  label: { name: string; detail: string },
) {
  const assets = desktopDownloads(os);
  const main =
    assets.find((a) => a.arch === (preferred[os] ?? "amd64")) ?? assets[0];
  return {
    icon,
    iconSize,
    ...label,
    main,
    others: assets.filter((a) => a !== main),
  };
}

const archName = (a: ReleaseAsset) =>
  copy.archNames[`${a.os}-${a.arch}`] ?? copy.archNames[a.arch] ?? a.arch;

const options = [
  platform("darwin", "apple", 25, copy.options.macos),
  platform("windows", "windows", 24, copy.options.windows),
  platform("linux", "linux", 26, copy.options.linux),
].filter((o) => o.main);
---

<section
  id="download"
  class="download-section container"
  aria-labelledby="download-title"
>
  <div class="download-inner">
    <div class="download-intro">
      <p class="eyebrow section-eyebrow">{copy.eyebrow}</p>
      <h2 id="download-title">
        <Lines lines={copy.title} />
      </h2>
      <p>
        <Lines lines={copy.description} />
      </p>
      <a class="text-link" href={localePath(lang, "/docs/install/")}>
        {copy.allReleases}
        <Icon name="arrow" size={15} />
      </a>
    </div>
    <div class="download-options">
      {options.map((option) => (
        <div class="download-option">
          <a class="download-option-main" href={option.main.url}>
            <span class="os-icon">
              <Icon name={option.icon} size={option.iconSize} stroke={1.75} />
            </span>
            <span>
              <strong>{option.name}</strong>
              <small>
                {option.detail} · {formatSize(option.main.size)}
              </small>
            </span>
            <span class="download-option-action">
              {copy.action}
              <Icon name="arrow" size={18} />
            </span>
          </a>
          {option.others.length > 0 && (
            <p class="download-option-others">
              {copy.otherArch}
              {option.others.map((asset) => (
                <a href={asset.url}>{archName(asset)}</a>
              ))}
            </p>
          )}
        </div>
      ))}
      <p class="headless-download">
        {copy.headlessPrompt}
        <a href={localePath(lang, "/docs/headless/")}>
          {copy.headlessLink}
          <Icon name="arrow" size={14} />
        </a>
      </p>
    </div>
  </div>
</section>

<style>
  .download-section {
    padding: 46px 40px;
    background: linear-gradient(110deg, #f0f7eb, #f1f8ed);
    border-radius: 12px;
  }
  .download-inner {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: 60px;
    align-items: center;
  }
  .download-intro h2 {
    font-size: clamp(40px, 5vw, 60px);
    margin-top: 20px;
    line-height: 1.28;
    letter-spacing: -1.5px;
  }
  .download-intro > p:not(.eyebrow) {
    font-size: 15px;
    line-height: 1.85;
    color: var(--muted);
    margin-top: 22px;
  }
  .download-intro > .text-link {
    margin-top: 26px;
    font-size: 13px;
    line-height: 1.7;
  }
  .download-options {
    display: grid;
    gap: 12px;
    min-width: 0;
  }
  .download-option {
    background: #ffffffed;
    border: 1px solid #eaf0e4;
    border-radius: 6px;
    transition:
      border-color 180ms,
      transform 180ms;
  }
  .download-option:hover {
    border-color: #9ccbbb;
    transform: translateX(3px);
  }
  .download-option-main {
    display: flex;
    align-items: center;
    gap: 20px;
    padding: 17px 22px;
  }
  .download-option-main > span:nth-child(2) {
    min-width: 0;
  }
  .download-option-others {
    display: flex;
    align-items: center;
    gap: 11px;
    margin: -8px 0 0;
    padding: 0 22px 10px 72px;
    font-size: 11px;
    color: var(--muted);
  }
  .download-option-others a {
    color: var(--teal);
    padding-block: 5px;
  }
  .download-option-others a:hover {
    text-decoration: underline;
  }
  .os-icon {
    width: 30px;
    color: var(--ink);
    flex-shrink: 0;
  }
  .os-icon :global(svg) {
    width: 30px;
    height: 30px;
  }
  .download-option strong {
    display: block;
    font-size: 17px;
    font-weight: 600;
  }
  .download-option small {
    display: block;
    margin-top: 4px;
    font-size: 12px;
    color: var(--muted);
    line-height: 1.6;
  }
  .download-option-action {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    gap: 9px;
    flex-shrink: 0;
    color: var(--teal);
    font-size: 12px;
    font-weight: 500;
  }
  .headless-download {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 6px;
    font-size: 12px;
    margin-top: 10px;
    padding-top: 20px;
    border-top: 1px solid #e0eadc;
    color: var(--muted);
  }
  .headless-download a {
    color: var(--teal);
    display: flex;
    align-items: center;
    gap: 5px;
    min-height: 32px;
  }
  .headless-download a:hover {
    text-decoration: underline;
  }
  @media (max-width: 1100px) {
    .download-inner {
      gap: 40px;
    }
    .download-option-main {
      padding-inline: 20px;
      gap: 16px;
    }
    .download-option small {
      font-size: 11px;
    }
    .download-option-action {
      font-size: 11px;
      gap: 7px;
    }
    .download-option-others {
      padding-left: 66px;
    }
    .download-intro > p:not(.eyebrow) {
      font-size: 14px;
    }
  }
  @media (max-width: 760px) {
    .download-section {
      padding: 32px 20px 24px;
    }
    .download-inner {
      grid-template-columns: minmax(0, 1fr);
      gap: 30px;
    }
    .download-intro h2 {
      font-size: 38px;
    }
    .download-intro > p:not(.eyebrow) {
      margin-top: 18px;
    }
    .download-intro > .text-link {
      margin-top: 20px;
    }
    .download-option-main {
      padding: 16px 12px;
      gap: 12px;
    }
    .download-option-others {
      padding: 0 12px 8px 50px;
    }
    .download-option-others a {
      padding-block: 8px;
    }
    .os-icon {
      width: 26px;
    }
    .os-icon :global(svg) {
      width: 26px;
      height: 26px;
    }
    .download-option strong {
      font-size: 15px;
    }
    .download-option small {
      font-size: 10px;
    }
    .download-option-action {
      font-size: 11px;
      gap: 4px;
    }
    .download-option-action :global(svg) {
      width: 14px;
    }
    .headless-download {
      font-size: 11px;
    }
    .headless-download a {
      min-height: 44px;
    }
  }
  @media (max-width: 390px) {
    .download-section {
      padding-inline: 16px;
    }
    .download-option-main {
      display: grid;
      grid-template-columns: 26px minmax(0, 1fr);
      gap: 6px 12px;
    }
    .download-option-action {
      grid-column: 2;
      margin-left: 0;
    }
  }
</style>
