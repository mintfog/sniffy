---
import Icon from "./Icon.astro";
import Lines from "./Lines.astro";
import { localePath, siteCopy, type Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const copy = siteCopy[lang].home.download;
const releases = "https://github.com/mintfog/sniffy/releases";
const options = [
  { icon: "apple", size: 25, ...copy.options.macos },
  { icon: "windows", size: 24, ...copy.options.windows },
  { icon: "linux", size: 26, ...copy.options.linux },
] as const;
---

<section
  id="download"
  class="download-section"
  aria-labelledby="download-title"
>
  <div class="container download-inner">
    <div class="download-intro">
      <p class="eyebrow section-eyebrow">
        <span class="status-dot"></span>
        {copy.eyebrow}
      </p>
      <h2 id="download-title">
        <Lines lines={copy.title} />
      </h2>
      <p>
        <Lines lines={copy.description} />
      </p>
      <a class="text-link" href={releases}>
        {copy.allReleases}
        <Icon name="external" size={15} />
      </a>
    </div>
    <div class="download-options">
      {options.map((option) => (
        <a class="download-option" href={releases}>
          <span class="os-icon">
            <Icon name={option.icon} size={option.size} stroke={1.75} />
          </span>
          <span>
            <strong>{option.name}</strong>
            <small>{option.detail}</small>
          </span>
          <span class="download-option-action">
            {copy.action}
            <Icon name="arrow" size={18} />
          </span>
        </a>
      ))}
      <p class="headless-download">
        {copy.headlessPrompt}
        <a href={localePath(lang, "/docs/headless/")}>
          {copy.headlessLink}
          <Icon name="arrow" size={14} />
        </a>
      </p>
    </div>
  </div>
</section>

<style>
  .download-section {
    padding-block: 61px;
    background: #eaf0e4;
    border-block: 1px solid #dce5d3;
  }
  .download-inner {
    display: grid;
    grid-template-columns: 1fr 1.05fr;
    gap: 80px;
    align-items: center;
  }
  .download-intro h2 {
    font-size: 39px;
    margin-top: 15px;
    line-height: 1.4;
  }
  .download-intro > p:not(.eyebrow) {
    font-size: 13px;
    line-height: 1.9;
    color: var(--muted);
    margin-top: 17px;
  }
  .download-intro > .text-link {
    margin-top: 22px;
    font-size: 11px;
  }
  .download-options {
    display: grid;
    gap: 9px;
  }
  .download-option {
    display: flex;
    align-items: center;
    gap: 18px;
    padding: 18px 20px;
    background: #f7f9f3;
    border: 1px solid #d6e0ce;
    border-radius: 5px;
    transition:
      background 180ms,
      border-color 180ms,
      transform 180ms;
  }
  .download-option:hover {
    background: white;
    border-color: #8eae92;
    transform: translateX(3px);
  }
  .os-icon {
    width: 30px;
    color: #435b3c;
  }
  .download-option strong {
    display: block;
    font-size: 15px;
    font-weight: 600;
  }
  .download-option small {
    display: block;
    margin-top: 5px;
    font-size: 10px;
    color: var(--muted);
  }
  .download-option-action {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    gap: 13px;
    color: var(--muted);
    font-size: 10px;
  }
  .headless-download {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 5px;
    font-size: 10px;
    margin-top: 12px;
    color: var(--muted);
  }
  .headless-download a {
    color: #476b43;
    display: flex;
    align-items: center;
    gap: 5px;
  }
  .headless-download a:hover {
    text-decoration: underline;
  }

  @media (max-width: 1000px) {
    .download-inner {
      gap: 40px;
    }
  }
  @media (max-width: 760px) {
    .download-section {
      padding-block: 40px;
    }
    .download-inner {
      grid-template-columns: 1fr;
      gap: 29px;
    }
    .download-intro h2 {
      font-size: 35px;
    }
    .download-intro > p:not(.eyebrow) {
      margin-top: 13px;
      font-size: 12px;
    }
    .download-option {
      padding: 16px;
      gap: 14px;
    }
    .download-option strong {
      font-size: 14px;
    }
    .download-option-action {
      gap: 7px;
    }
  }
  @media (max-width: 390px) {
    .download-option-action {
      font-size: 9px;
    }
  }
</style>
