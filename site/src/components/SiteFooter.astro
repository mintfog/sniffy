---
import BrandMark from "./BrandMark.astro";
import Icon from "./Icon.astro";
import { localePath, siteCopy, type Lang } from "../i18n/ui";
import { repository } from "../data/repository";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const copy = siteCopy[lang].home.footer;
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <BrandMark lang={lang} imageSize={24} />
        <p class="footer-tagline">{copy.tagline}</p>
      </div>

      <div class="footer-col">
        <h3>{copy.columns.product}</h3>
        <ul>
          <li><a href={localePath(lang, "/download/")}>{copy.links.download}</a></li>
          <li><a href={localePath(lang, "/docs/desktop/")}>{copy.links.desktop}</a></li>
          <li><a href={localePath(lang, "/docs/headless/")}>{copy.links.headless}</a></li>
          <li>
            <a
              href={`${repository}/releases`}
              target="_blank"
              rel="noopener noreferrer"
            >
              {copy.links.releases}
              <Icon name="arrowUpRight" size={12} />
            </a>
          </li>
        </ul>
      </div>

      <div class="footer-col">
        <h3>{copy.columns.docs}</h3>
        <ul>
          <li><a href={localePath(lang, "/docs/")}>{copy.links.quickStart}</a></li>
          <li><a href={localePath(lang, "/docs/https/")}>{copy.links.https}</a></li>
          <li><a href={localePath(lang, "/docs/rules/")}>{copy.links.rules}</a></li>
          <li><a href={localePath(lang, "/docs/plugins/")}>{copy.links.plugins}</a></li>
          <li><a href={localePath(lang, "/docs/api/")}>{copy.links.api}</a></li>
        </ul>
      </div>

      <div class="footer-col">
        <h3>{copy.columns.community}</h3>
        <ul>
          <li>
            <a href={repository} target="_blank" rel="noopener noreferrer">
              {copy.links.github}
              <Icon name="arrowUpRight" size={12} />
            </a>
          </li>
          <li>
            <a
              href={`${repository}/issues`}
              target="_blank"
              rel="noopener noreferrer"
            >
              {copy.links.issues}
              <Icon name="arrowUpRight" size={12} />
            </a>
          </li>
          <li>
            <a
              href={`${repository}/blob/main/LICENSE`}
              target="_blank"
              rel="noopener noreferrer"
            >
              {copy.links.license}
              <Icon name="arrowUpRight" size={12} />
            </a>
          </li>
          <li>
            <a href={localePath(lang, "/docs/third-party/")}>
              {copy.links.thirdParty}
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <span>© {new Date().getFullYear()} {copy.copyright}</span>
      <span aria-hidden="true">·</span>
      <a
        href={`${repository}/blob/main/LICENSE`}
        target="_blank"
        rel="noopener noreferrer"
      >
        {copy.licenseText}
      </a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--surface);
    padding-top: 48px;
  }
  .footer-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) repeat(3, minmax(0, 1fr));
    gap: 36px;
    padding-bottom: 40px;
  }
  .footer-brand {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
  }
  .footer-tagline {
    max-width: 320px;
    color: var(--muted);
    font-size: 13.5px;
    line-height: 1.65;
  }
  .footer-col h3 {
    font-size: 13px;
    font-weight: 600;
    color: var(--ink);
    margin-bottom: 12px;
  }
  .footer-col ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 9px;
  }
  .footer-col a {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 13px;
    color: var(--muted);
    transition: color 140ms ease;
  }
  .footer-col a:hover {
    color: var(--ink);
  }
  .footer-bottom {
    border-top: 1px solid var(--line);
    padding-block: 18px 24px;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px 12px;
    font-size: 12.5px;
    color: var(--faint);
  }
  .footer-bottom a:hover {
    color: var(--ink);
  }

  @media (max-width: 900px) {
    .footer-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 28px;
    }
    .footer-brand {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 560px) {
    .site-footer {
      padding-top: 36px;
    }
    .footer-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 24px;
      padding-bottom: 28px;
    }
  }
</style>
