---
import Lines from "./Lines.astro";
import type { Paragraph } from "../i18n/ui";

interface Props {
  id: string;
  eyebrow: string;
  title: string;
  aside: Paragraph;
}

const { id, eyebrow, title, aside } = Astro.props;
---

<div class="section-heading" data-reveal>
  <div>
    <p class="eyebrow section-eyebrow">{eyebrow}</p>
    <h2 id={id}>{title}</h2>
  </div>
  <p>
    <Lines lines={aside} />
  </p>
</div>

<style>
  .section-heading {
    display: grid;
    gap: 14px;
    margin-bottom: 43px;
  }
  .section-heading h2 {
    margin-top: 12px;
  }
  .section-heading > p {
    max-width: 720px;
    font-size: 15px;
    line-height: 1.9;
    color: var(--muted);
  }

  .section-heading > p::after {
    content: "";
    display: block;
    width: 34px;
    height: 1px;
    background: #65cdb8;
    margin-top: 18px;
  }
  @media (max-width: 1000px) {
    .section-heading > p {
      font-size: 13px;
    }
  }
  @media (max-width: 760px) {
    .section-heading {
      display: block;
      margin-bottom: 25px;
    }
    .section-heading > p {
      margin-top: 12px;
      font-size: 12px;
    }
    .section-heading > p :global(br) {
      display: none;
    }
  }
</style>
