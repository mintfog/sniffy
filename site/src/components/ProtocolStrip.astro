---
import { siteCopy, type Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const copy = siteCopy[lang].home.protocols;
---

<div class="protocol-strip container" data-reveal>
  <div>
    <span>{copy.intro}</span>
    <div>
      {copy.items.map((item) => (
        <b>{item}</b>
      ))}
    </div>
  </div>
</div>

<style>
  .protocol-strip {
    margin-top: 28px;
    padding: 38px 40px;
    border-radius: 12px;
    background: var(--mint);
  }
  .protocol-strip > div {
    display: flex;
    align-items: center;
    gap: 36px;
  }
  .protocol-strip > div > span {
    font-size: clamp(17px, 2.25vw, 26px);
    font-weight: 600;
    letter-spacing: -0.5px;
  }
  .protocol-strip > div > div {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .protocol-strip b {
    padding: 10px 20px;
    border-left: 1px solid #cbded7;
    font: 400 12px var(--mono);
    color: var(--muted);
  }
  .protocol-strip b:last-child {
    padding-right: 0;
  }
  @media (max-width: 1100px) {
    .protocol-strip {
      padding: 35px 30px;
    }
    .protocol-strip > div {
      gap: 24px;
    }
    .protocol-strip b {
      padding-inline: 15px;
      font-size: 11px;
    }
  }
  @media (max-width: 900px) {
    .protocol-strip > div {
      flex-direction: column;
      align-items: stretch;
      gap: 22px;
    }
    .protocol-strip > div > span {
      text-align: center;
    }
    .protocol-strip b:first-child {
      border-left: 0;
      padding-left: 0;
    }
  }
  @media (max-width: 760px) {
    .protocol-strip {
      padding: 25px 20px;
      margin-top: 18px;
    }
    .protocol-strip > div > div {
      flex-wrap: wrap;
      justify-content: center;
      gap: 12px 18px;
    }
    .protocol-strip b,
    .protocol-strip b:last-child {
      padding: 0;
      border: 0;
      font-size: 11px;
    }
  }
</style>
