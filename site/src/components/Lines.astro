---
interface Props {
  lines: string[];
  brClass?: string;
}

const { lines, brClass } = Astro.props;
---

{
  /* 行间的空格不可省：窄屏下 CSS 会隐藏 <br>，两行会直接首尾相连。 */
  lines.map((line, index) => (
    <Fragment>
      {index > 0 && " "}
      {index > 0 && <br class={brClass} />}
      {line}
    </Fragment>
  ))
}
