---
import Icon from "./Icon.astro";
import { siteCopy, type Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const copy = siteCopy(lang).workbench;
const proxyAddress = "127.0.0.1:8080";

type Kind = "json" | "image" | "media" | "markup";
type NoteKey = keyof typeof copy.notes;

interface Session {
  index: number;
  /** null 表示请求未拿到响应，列表里显示 ERR。 */
  status: number | null;
  method: string;
  scheme: "https" | "http";
  host: string;
  target: string;
  kind: Kind;
  duration: string;
  clientPort: number;
  startedAt: string;
  contentType: string;
  size: string;
  body?: unknown;
  note?: NoteKey;
  reqBody?: unknown;
  cookie?: [string, string];
}

const sessions: Session[] = [
  {
