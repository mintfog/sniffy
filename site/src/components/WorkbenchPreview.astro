---
import Icon from "./Icon.astro";
import JsonNode from "./JsonNode.astro";
import { createDemoSessions, type FilterGroup } from "../data/workbench";
import { siteCopy, type Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const copy = siteCopy[lang].workbench;
const proxyAddress = "192.168.1.20:8080";

const details = createDemoSessions(copy);

// 芯片顺序、分组与应用的流量筛选栏一致。
const chipGroups: { group: FilterGroup | "all"; chips: [string, string][] }[] =
  [
    { group: "all", chips: [["all", copy.filters.all]] },
    {
      group: "protocol",
      chips: [
        ["https", "HTTPS"],
        ["http", "HTTP"],
        ["ws", "WS"],
      ],
    },
    {
      group: "version",
      chips: [
        ["h1", "HTTP/1"],
        ["h2", "HTTP/2"],
      ],
    },
    {
      group: "content",
      chips: [
        ["json", "JSON"],
        ["xml", "XML"],
        ["text", copy.filters.text],
        ["html", "HTML"],
        ["js", "JS"],
        ["css", "CSS"],
        ["image", copy.filters.images],
        ["media", copy.filters.media],
        ["binary", copy.filters.binary],
      ],
    },
    {
      group: "status",
      chips: [
        ["1xx", "1xx"],
        ["2xx", "2xx"],
        ["3xx", "3xx"],
        ["4xx", "4xx"],
        ["5xx", "5xx"],
        ["err", copy.filters.errors],
      ],
    },
  ];

const kindIcon = {
  json: "braces",
  image: "image",
  video: "film",
  text: "file",
  other: "blank",
} as const;

const reqTabs = [
  { id: "overview", label: copy.reqTabs.overview },
  { id: "params", label: copy.reqTabs.params },
  { id: "headers", label: copy.reqTabs.headers },
  { id: "body", label: copy.reqTabs.body },
  { id: "cookies", label: copy.reqTabs.cookies },
  { id: "raw", label: copy.reqTabs.raw },
  { id: "executions", label: copy.reqTabs.executions },
];
const resTabs = [
  { id: "body", label: copy.resTabs.body },
  { id: "headers", label: copy.resTabs.headers },
  { id: "cookies", label: copy.resTabs.cookies },
  { id: "raw", label: copy.resTabs.raw },
];
const views = [
  { id: "tree", label: copy.views.tree },
  { id: "raw", label: copy.views.raw },
  { id: "hex", label: copy.views.hex },
];

const [showingBefore, showingAfter] = copy.statusBar.showing.split("{n}");
const [selectedBefore, selectedAfter] = copy.statusBar.selected.split("{n}");

const summaries = details.map((detail) => detail.summary);
const first = summaries[0];
---

<div
  class="workbench"
  data-workbench
  data-sessions={JSON.stringify(summaries)}
>
  <div class="wb-titlebar">
    <div class="window-dots" aria-hidden="true">
      <i></i>
      <i></i>
      <i></i>
    </div>
    <span class="wb-brand">
      <img src="/sniffy-mark.png" alt="" width="20" height="20" />
      SNIFFY
    </span>
    <span class="wb-connected">
      <span class="status-dot"></span>
      {copy.connected}
    </span>
    <span class="wb-theme" aria-hidden="true">
      <Icon name="moon" size={16} />
    </span>
    <span class="demo-label">{copy.demoLabel}</span>
  </div>

  <div class="wb-main">
    <div class="wb-rail" aria-hidden="true">
      <span class="rail-active"><Icon name="activity" size={16} /></span>
      <span><Icon name="shuffle" size={16} stroke={1.75} /></span>
      <span><Icon name="dot" size={16} stroke={1.75} /></span>
      <span><Icon name="puzzle" size={16} stroke={1.75} /></span>
      <span><Icon name="shield" size={16} stroke={1.75} /></span>
      <span class="rail-bottom">
        <Icon name="settings" size={16} stroke={1.75} />
      </span>
    </div>

    <div class="wb-content">
      <div class="wb-proxybar">
        <div class="proxy-field">
          <span class="listen-dot"></span>
          <span class="proxy-listen">
            {copy.listening}
            <span class="mono-muted">{proxyAddress}</span>
            <Icon name="caret" size={12} class="proxy-caret" />
          </span>
          <span class="proxy-pill">{copy.networks}</span>
          <span class="proxy-pill proxy-on">{copy.systemProxyOn}</span>
          <Icon name="pencil" size={12} class="proxy-pencil" />
        </div>
        <span class="proxy-tools" aria-hidden="true">
          <span class="tool-active"><Icon name="globe" size={16} /></span>
          <span><Icon name="shuffle" size={16} /></span>
          <span><Icon name="dot" size={16} /></span>
          <span><Icon name="puzzle" size={16} /></span>
          <span><Icon name="gauge" size={16} /></span>
          <span><Icon name="shield" size={16} /></span>
        </span>
        <span class="proxy-sep" aria-hidden="true"></span>
        <span class="wb-pause">
          <Icon name="pause" size={14} />
          <span class="pause-label">{copy.pause}</span>
        </span>
        <span class="proxy-trash" aria-hidden="true">
          <Icon name="trash" size={16} />
        </span>
      </div>

      <div class="wb-filters">
        <div class="filter-chips" role="group" aria-label={copy.a11y.filters}>
          {chipGroups.map(({ group, chips }, g) => (
            <Fragment>
              {g > 0 && <span class="chip-sep" aria-hidden="true" />}
              {chips.map(([key, label]) => (
                <button
                  type="button"
                  class:list={["filter-chip", { active: key === "all" }]}
                  data-chip={key}
                  data-group={group}
                  aria-pressed={key === "all"}
                >
                  {label}
                </button>
              ))}
            </Fragment>
          ))}
        </div>
        <span class="filter-actions" aria-hidden="true">
          <span class="tool-active"><Icon name="follow" size={16} /></span>
          <span><Icon name="search" size={16} /></span>
        </span>
      </div>

      <div class="wb-body">
        <div class="wb-sessions">
          <div class="session-heading">
            <span>{copy.columns.status}</span>
            <span class="cell-index">{copy.columns.index}</span>
            <span></span>
            <span>{copy.columns.method}</span>
            <span>{copy.columns.url}</span>
            <span class="cell-duration">{copy.columns.duration}</span>
          </div>
          <div
            class="session-list"
            role="list"
            aria-label={copy.a11y.sessionList}
          >
            {details.map(({ session, failed, tone, filters }, i) => (
              <div
                role="listitem"
                class="session-item"
                data-protocol={filters.protocol.join(" ")}
                data-version={filters.version.join(" ")}
                data-content={filters.content.join(" ")}
                data-status={filters.status.join(" ")}
              >
                <button
                  type="button"
                  class:list={["session-row", { selected: i === 0, failed }]}
                  data-session={i}
                  aria-pressed={i === 0}
                >
                  <span class={`cell-status tone-${tone}`}>
                    <span class="status-dot"></span>
                    {failed ? "ERR" : session.status}
                  </span>
                  <span class="cell-index">{session.index}</span>
                  <span class={`cell-kind kind-${session.kind}`}>
                    <Icon name={kindIcon[session.kind]} size={14} />
                  </span>
                  <span class={`cell-method method-${session.method}`}>
                    {session.method}
                  </span>
                  <span class="cell-url">
                    {session.scheme === "https" ? (
                      <Icon name="lock" size={12} class="lock-icon" />
                    ) : (
                      <span class="lock-icon" />
                    )}
                    <span class="cell-url-text">
                      {session.host}
                      <span>{session.target}</span>
                    </span>
                  </span>
                  <span class="cell-duration">{session.duration}</span>
                </button>
              </div>
            ))}
          </div>
          <p class="empty-sessions" hidden>
            {copy.empty}
          </p>
        </div>

        <div class="wb-detail">
          <div class="detail-pane">
            <div class="tab-row">
              <div
                class="tab-list"
                role="tablist"
                aria-label={copy.a11y.requestTabs}
              >
                {reqTabs.map((tab, i) => (
                  <button
                    type="button"
                    role="tab"
                    class="detail-tab"
                    data-req-tab={tab.id}
                    aria-selected={i === 0}
                    tabindex={i === 0 ? 0 : -1}
                    hidden={tab.id === "params" && !first.parameterCount}
                  >
                    {tab.label}
                    {tab.id === "params" && (
                      <b data-count-params>{first.parameterCount || ""}</b>
                    )}
                    {tab.id === "headers" && (
                      <b data-count-req-headers>{first.requestHeaderCount}</b>
                    )}
                    {tab.id === "cookies" && (
                      <b data-count-req-cookies>{first.cookieCount || ""}</b>
                    )}
                  </button>
                ))}
              </div>
              <span class="tab-actions" aria-hidden="true">
                <span
                  class={`req-pill method-${first.method}`}
                  data-pill-method
                >
                  {first.method}
                </span>
                <Icon name="copy" size={14} />
                <Icon name="close" size={14} />
              </span>
            </div>
            <div class="pane-scroll" tabindex="0">
              {details.map((detail, i) => (
                <div data-req={i} hidden={i !== 0}>
                  <div data-req-panel="overview">
                    <div class="url-line">
                      <span class="url-faint">{detail.session.scheme}://</span>
                      <span class="url-host">{detail.session.host}</span>
                      <span class="url-path">{detail.path}</span>
                      {detail.params.map(([key, value], p) => (
                        <Fragment>
                          <span class="url-faint">{p === 0 ? "?" : "&"}</span>
                          <span class="url-key">{key}</span>
                          <span class="url-faint">=</span>
                          <span class="url-value">{value}</span>
                        </Fragment>
                      ))}
                    </div>
                    {detail.failed && (
                      <div class="error-banner">
                        {copy.notes.connectionReset}
                      </div>
                    )}
                    <dl class="kv">
                      <dt>{copy.overview.state}</dt>
                      <dd>
                        {detail.failed ? copy.stateError : copy.stateDone}
                      </dd>
                      <dt>{copy.overview.method}</dt>
                      <dd>{detail.session.method}</dd>
                      <dt>{copy.overview.scheme}</dt>
                      <dd>{detail.session.scheme.toUpperCase()}</dd>
                      <dt>{copy.overview.clientIP}</dt>
                      <dd>127.0.0.1</dd>
                      <dt>{copy.overview.contentType}</dt>
                      <dd>{detail.session.contentType}</dd>
                      <dt>{copy.overview.process}</dt>
                      <dd>—</dd>
                      <dt>{copy.overview.startedAt}</dt>
                      <dd>{detail.session.startedAt}</dd>
                      <dt>{copy.overview.duration}</dt>
                      <dd>{detail.session.duration}</dd>
                      <dt>{copy.overview.size}</dt>
                      <dd>{detail.size}</dd>
                    </dl>
                  </div>
                  <dl class="kv" data-req-panel="params" hidden>
                    {detail.params.map(([k, v]) => (
                      <Fragment>
                        <dt>{k}</dt>
                        <dd>{v}</dd>
                      </Fragment>
                    ))}
                  </dl>
                  <dl class="kv" data-req-panel="headers" hidden>
                    {detail.requestHeaders.map(([k, v]) => (
                      <Fragment>
                        <dt>{k}</dt>
                        <dd>{v}</dd>
                      </Fragment>
                    ))}
                  </dl>
                  <div data-req-panel="body" hidden>
                    {detail.session.reqBody !== undefined ? (
                      <pre class="raw-text">{JSON.stringify(detail.session.reqBody, null, 2)}</pre>
                    ) : (
                      <p class="pane-empty">{copy.emptyBody}</p>
                    )}
                  </div>
                  <div data-req-panel="cookies" hidden>
                    {detail.session.cookie ? (
                      <dl class="kv">
                        <dt>{detail.session.cookie[0]}</dt>
                        <dd>{detail.session.cookie[1]}</dd>
                      </dl>
                    ) : (
                      <p class="pane-empty">{copy.emptyCookies}</p>
                    )}
                  </div>
                  <div data-req-panel="raw" hidden>
                    <pre class="raw-text">{detail.rawRequest}</pre>
                  </div>
                  <div data-req-panel="executions" hidden>
                    <p class="pane-empty">{copy.emptyExecutions}</p>
                  </div>
                </div>
              ))}
            </div>
          </div>

          <div class="detail-pane detail-response">
            <div class="tab-row">
              <div
                class="tab-list"
                role="tablist"
                aria-label={copy.a11y.responseTabs}
              >
                {resTabs.map((tab, i) => (
                  <button
                    type="button"
                    role="tab"
                    class="detail-tab"
                    data-res-tab={tab.id}
                    aria-selected={i === 0}
                    tabindex={i === 0 ? 0 : -1}
                  >
                    {tab.label}
                    {tab.id === "headers" && (
                      <b data-count-res-headers>{first.responseHeaderCount}</b>
                    )}
                  </button>
                ))}
              </div>
              <span class="tab-actions" aria-hidden="true">
                <span class="proto-pill" data-pill-proto>
                  {first.protocol}
                </span>
                <span class={`status-text tone-${first.tone}`} data-res-status>
                  {first.status}
                </span>
                <Icon name="copy" size={14} />
                <Icon name="download" size={14} />
              </span>
            </div>
            <div class="view-bar">
              <div
                class="view-switch"
                role="group"
                aria-label={copy.a11y.bodyViews}
              >
                {views.map((view, i) => (
                  <button
                    type="button"
                    class:list={["view-button", { active: i === 0 }]}
                    data-view={view.id}
                    aria-pressed={i === 0}
                  >
                    {view.label}
                  </button>
                ))}
              </div>
              <Icon name="copy" size={14} class="view-copy" />
            </div>
            <div class="pane-scroll" tabindex="0">
              {details.map((detail, i) => (
                <div data-res={i} hidden={i !== 0}>
                  <div data-res-panel="body">
                    {detail.session.body !== undefined ? (
                      <Fragment>
                        <div class="json-tree" data-view-panel="tree">
                          <JsonNode
                            name={null}
                            value={detail.session.body}
                            depth={0}
                            isLast
                            labels={copy.json}
                          />
                        </div>
                        <pre class="raw-text" data-view-panel="raw" hidden>{detail.compactBody}</pre>
                        <pre class="raw-text hex-text" data-view-panel="hex" hidden>{detail.hex}</pre>
                      </Fragment>
                    ) : (
                      <p class="pane-empty">
                        {copy.notes[detail.session.note ?? "binary"]}
                        {!detail.failed && <span> · {detail.size}</span>}
                      </p>
                    )}
                  </div>
                  <dl class="kv" data-res-panel="headers" hidden>
                    {detail.responseHeaders.map(([k, v]) => (
                      <Fragment>
                        <dt>{k}</dt>
                        <dd>{v}</dd>
                      </Fragment>
                    ))}
                  </dl>
                  <div data-res-panel="cookies" hidden>
                    <p class="pane-empty">{copy.emptyCookies}</p>
                  </div>
                  <div data-res-panel="raw" hidden>
                    <pre class="raw-text">{detail.rawResponse}</pre>
                  </div>
                </div>
              ))}
            </div>
          </div>

          <p class="empty-detail" hidden>
            {copy.emptyDetail}
          </p>
        </div>
      </div>
    </div>
  </div>

  <div class="wb-statusbar">
    <span class="statusbar-listen">
      <Icon name="globe" size={12} />
      {copy.listening}
      <span class="mono-muted">{proxyAddress}</span>
    </span>
    <span class="statusbar-sep"></span>
    <span class="statusbar-capture">
      <Icon name="radio" size={12} />
      {copy.statusBar.capturing}
    </span>
    <span class="statusbar-right">
      <span>
        {showingBefore}<b data-showing></b>{showingAfter}
      </span>
      <span class="statusbar-sep" data-selected-sep></span>
      <span data-selected>
        {selectedBefore}<b class="accent" data-selected-index></b>{selectedAfter}
      </span>
      <span class="statusbar-sep"></span>
      <span class="statusbar-live">
        <Icon name="wifi" size={12} />
        {copy.statusBar.live}
      </span>
    </span>
  </div>
</div>

<script>
  import type { SessionSummary } from "../data/workbench";

  const workbench = document.querySelector<HTMLElement>("[data-workbench]")!;
  const sessions: SessionSummary[] = JSON.parse(workbench.dataset.sessions!);
  const groups = ["protocol", "version", "content", "status"] as const;
  type Group = (typeof groups)[number];

  // 过滤切换的是 listitem 外层：只隐藏内层按钮会让空壳列表项留在可访问性树里。
  const items = [...workbench.querySelectorAll<HTMLElement>(".session-item")];
  const rows = items.map(
    (item) => item.querySelector<HTMLButtonElement>("[data-session]")!,
  );
  const $ = <T extends HTMLElement = HTMLElement>(selector: string) =>
    workbench.querySelector<T>(selector)!;
  const showing = $("[data-showing]");
  const selected = $("[data-selected]");
  const selectedSep = $("[data-selected-sep]");
  const emptySessions = $(".empty-sessions");
  const emptyDetail = $(".empty-detail");
  const detailPanes = [
    ...workbench.querySelectorAll<HTMLElement>(".detail-pane"),
  ];
  const paramsTab = $<HTMLButtonElement>('[data-req-tab="params"]');

  // 只换带前缀的那一个类：整体改写 className 会丢掉 Astro 的作用域类，样式随之失效。
  function swapClass(el: HTMLElement, prefix: string, value: string) {
    el.classList.forEach((name) => {
      if (name.startsWith(prefix)) el.classList.remove(name);
    });
    el.classList.add(prefix + value);
  }

  function updateCounts() {
    showing.textContent = String(items.filter((item) => !item.hidden).length);
  }

  function clearSelection() {
    rows.forEach((row) => {
      row.classList.remove("selected");
      row.setAttribute("aria-pressed", "false");
    });
    detailPanes.forEach((pane) => (pane.hidden = true));
    emptyDetail.hidden = false;
    selected.hidden = selectedSep.hidden = true;
  }

  function selectSession(index: number) {
    const session = sessions[index];
    rows.forEach((row) => {
      const active = Number(row.dataset.session) === index;
      row.classList.toggle("selected", active);
      row.setAttribute("aria-pressed", String(active));
    });
    detailPanes.forEach((pane) => (pane.hidden = false));
    emptyDetail.hidden = true;
    selected.hidden = selectedSep.hidden = false;
    workbench.querySelectorAll<HTMLElement>("[data-req]").forEach((pane) => {
      pane.hidden = Number(pane.dataset.req) !== index;
    });
    workbench.querySelectorAll<HTMLElement>("[data-res]").forEach((pane) => {
      pane.hidden = Number(pane.dataset.res) !== index;
    });

    const method = $("[data-pill-method]");
    method.textContent = session.method;
    swapClass(method, "method-", session.method);
    const status = $("[data-res-status]");
    status.textContent = session.status;
    swapClass(status, "tone-", session.tone);
    const proto = $("[data-pill-proto]");
    proto.textContent = session.protocol;
    proto.hidden = !session.protocol;

    // 计数为 0 时不出数字，与应用一致。
    const badge = (selector: string, value: number) => {
      $(selector).textContent = value ? String(value) : "";
    };
    badge("[data-count-params]", session.parameterCount);
    badge("[data-count-req-headers]", session.requestHeaderCount);
    badge("[data-count-req-cookies]", session.cookieCount);
    badge("[data-count-res-headers]", session.responseHeaderCount);
    // 应用只在有查询参数时出「参数」页签；切到没有参数的请求时回到总览。
    paramsTab.hidden = !session.parameterCount;
    if (paramsTab.hidden && paramsTab.getAttribute("aria-selected") === "true")
      selectReqTab("overview");
    $("[data-selected-index]").textContent = String(session.index);
    hasTree = session.hasTree;
    updateViewBar();
  }

  rows.forEach((row) =>
    row.addEventListener("click", () =>
      selectSession(Number(row.dataset.session)),
    ),
  );

  // 组内单选、再点取消，组间按「与」叠加；「全部」清空所有维度。
  const selection: Partial<Record<Group, string>> = {};
  const chips = [
    ...workbench.querySelectorAll<HTMLButtonElement>("[data-chip]"),
  ];
  function applyFilter() {
    const empty = groups.every((group) => !selection[group]);
    chips.forEach((chip) => {
      const group = chip.dataset.group as Group | "all";
      const active =
        group === "all" ? empty : selection[group] === chip.dataset.chip;
      chip.classList.toggle("active", active);
      chip.setAttribute("aria-pressed", String(active));
    });
    items.forEach((item) => {
      item.hidden = groups.some((group) => {
        const want = selection[group];
        return want && !item.dataset[group]!.split(" ").includes(want);
      });
    });
    updateCounts();
    const current = rows.findIndex(
      (row, i) => row.classList.contains("selected") && !items[i].hidden,
    );
    const firstVisible = items.findIndex((item) => !item.hidden);
    emptySessions.hidden = firstVisible >= 0;
    if (firstVisible < 0) clearSelection();
    else if (current < 0)
      selectSession(Number(rows[firstVisible].dataset.session));
  }
  chips.forEach((chip) => {
    chip.addEventListener("click", () => {
      const group = chip.dataset.group as Group | "all";
      const key = chip.dataset.chip!;
      if (group === "all") groups.forEach((g) => delete selection[g]);
      else if (selection[group] === key) delete selection[group];
      else selection[group] = key;
      applyFilter();
    });
  });

  function bindTabs(
    attribute: string,
    panelAttribute: string,
    onSelect?: (name: string) => void,
  ) {
    const tabs = [
      ...workbench.querySelectorAll<HTMLButtonElement>(`[${attribute}]`),
    ];
    function select(tab: HTMLButtonElement) {
      const name = tab.getAttribute(attribute)!;
      tabs.forEach((item) => {
        item.setAttribute("aria-selected", String(item === tab));
        item.tabIndex = item === tab ? 0 : -1;
      });
      workbench
        .querySelectorAll<HTMLElement>(`[${panelAttribute}]`)
        .forEach((panel) => {
          panel.hidden = panel.getAttribute(panelAttribute) !== name;
        });
      onSelect?.(name);
    }
    tabs.forEach((tab) => {
      tab.addEventListener("click", () => select(tab));
      tab.addEventListener("keydown", (event) => {
        const visible = tabs.filter((item) => !item.hidden);
        const index = visible.indexOf(tab);
        let next;
        if (event.key === "ArrowRight") next = (index + 1) % visible.length;
        if (event.key === "ArrowLeft")
          next = (index + visible.length - 1) % visible.length;
        if (event.key === "Home") next = 0;
        if (event.key === "End") next = visible.length - 1;
        if (next === undefined) return;
        event.preventDefault();
        select(visible[next]);
        visible[next].focus();
      });
    });
    return (name: string) =>
      select(tabs.find((tab) => tab.getAttribute(attribute) === name)!);
  }

  // Tree / Raw / Hex 只对有 JSON 正文的响应体出现。
  const viewBar = $(".view-bar");
  let resTab = "body";
  let hasTree = sessions[0].hasTree;
  const updateViewBar = () => {
    viewBar.hidden = resTab !== "body" || !hasTree;
  };
  const selectReqTab = bindTabs("data-req-tab", "data-req-panel");
  bindTabs("data-res-tab", "data-res-panel", (name) => {
    resTab = name;
    updateViewBar();
  });

  const viewButtons = [
    ...workbench.querySelectorAll<HTMLButtonElement>("[data-view]"),
  ];
  viewButtons.forEach((button) => {
    button.addEventListener("click", () => {
      viewButtons.forEach((item) => {
        item.classList.toggle("active", item === button);
        item.setAttribute("aria-pressed", String(item === button));
      });
      workbench
        .querySelectorAll<HTMLElement>("[data-view-panel]")
        .forEach((panel) => {
          panel.hidden = panel.dataset.viewPanel !== button.dataset.view;
        });
    });
  });

  workbench.querySelectorAll<HTMLElement>(".json-head").forEach((head) => {
    head.addEventListener("click", () => {
      head.parentElement!.toggleAttribute("data-open");
    });
  });

  // 芯片行与页签栏放不下时横向滚动：滚轮纵向滚动映射为横向，两侧渐隐提示还有内容。
  function scrollStrip(strip: HTMLElement) {
    function updateFade() {
      const left = strip.scrollLeft > 0;
      const right =
        strip.scrollLeft + strip.clientWidth < strip.scrollWidth - 1;
      strip.classList.toggle("fade-left", left);
      strip.classList.toggle("fade-right", right);
    }
    strip.addEventListener("scroll", updateFade, { passive: true });
    strip.addEventListener(
      "wheel",
      (event) => {
        if (event.deltaY === 0 || event.deltaX !== 0) return;
        // 已滚到该方向尽头时放行，否则页面纵向滚动会卡在这一行上。
        const max = strip.scrollWidth - strip.clientWidth;
        const atEdge =
          event.deltaY < 0
            ? strip.scrollLeft <= 0
            : strip.scrollLeft >= max - 1;
        if (atEdge) return;
        event.preventDefault();
        strip.scrollLeft += event.deltaY;
      },
      { passive: false },
    );
    return updateFade;
  }

  const chipRow = $(".filter-chips");
  new ResizeObserver(scrollStrip(chipRow)).observe(chipRow);

  // 页签与右侧操作区放不下时先收起操作区，仍放不下再靠横向滚动。收起时操作区只是不可见、
  // 仍参与测量，宽度够了能再展开。各页签也要观察：切换请求会增删「参数」页签、改计数，
  // 而页签栏已被挤满时它自身尺寸不变。
  workbench.querySelectorAll<HTMLElement>(".tab-row").forEach((row) => {
    const list = row.querySelector<HTMLElement>(".tab-list")!;
    const actions = row.querySelector<HTMLElement>(".tab-actions")!;
    const updateFade = scrollStrip(list);
    const observer = new ResizeObserver(() => {
      row.classList.toggle(
        "compact",
        list.scrollWidth + actions.offsetWidth > row.clientWidth,
      );
      updateFade();
    });
    [row, list, actions, ...list.children].forEach((el) =>
      observer.observe(el),
    );
  });

  selectSession(0);
  updateCounts();
</script>

