---
interface Props {
  kind: "capture" | "debug" | "plugins";
}
const { kind } = Astro.props;
---

<svg
  class="flow-illustration"
  viewBox="0 0 300 140"
  fill="none"
  aria-hidden="true"
>
  <path d="M12 70H288" stroke="#b9e9df" stroke-width="1" />
  {kind === "capture" && (
    <>
      {[54, 42, 30, 18].map((r, i) => (
        <circle
          cx="100"
          cy="70"
          r={r}
          stroke="#11af97"
          stroke-opacity={(i + 1) * 0.16}
        />
      ))}
      <circle cx="100" cy="70" r="9" fill="#009c85" />
      <circle cx="100" cy="70" r="14" fill="#1ac7a7" fill-opacity=".12" />
      <circle cx="238" cy="70" r="5" fill="#009c85" />
    </>
  )}
  {kind === "debug" && (
    <>
      <circle cx="150" cy="70" r="39" fill="var(--paper)" />
      <circle cx="150" cy="70" r="30" stroke="#00a18b" stroke-width="2" />
      <path
        d="M144 59V81M156 59V81"
        stroke="#00a18b"
        stroke-width="3"
        stroke-linecap="round"
      />
      <circle cx="45" cy="70" r="4.5" fill="#009c85" />
      <circle cx="75" cy="70" r="2" fill="#54cbb4" />
      <circle cx="255" cy="70" r="4.5" fill="#009c85" />
      <circle cx="225" cy="70" r="2" fill="#54cbb4" />
    </>
  )}
  {kind === "plugins" && (
    <>
      <path
        d="M111 26C91 26 96 43 96 54Q96 70 85 70Q96 70 96 86C96 103 91 114 111 114M189 26C209 26 204 43 204 54Q204 70 215 70Q204 70 204 86C204 103 209 114 189 114"
        stroke="#009c85"
        stroke-width="2.5"
      />
      <circle cx="40" cy="70" r="4.5" fill="#009c85" />
      <circle cx="150" cy="70" r="4.5" fill="#009c85" />
      <circle cx="260" cy="70" r="4.5" fill="#009c85" />
    </>
  )}
</svg>

<style>
  .flow-illustration {
    display: block;
    width: 100%;
    height: auto;
  }
</style>
