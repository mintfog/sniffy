---
import Icon from "./Icon.astro";
import { siteCopy, type Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
  name: string;
  note: string;
}
const { lang, name, note } = Astro.props;
const copy = siteCopy[lang].home.automation;
---

<form
  class="demo-flow"
  data-demo-flow={name}
  data-pending={copy.pending}
  data-running={copy.running}
  data-failed={copy.failed}
>
  <div class="flow-stage">
    <div class="flow-card flow-input">
      <p class="flow-step">
        <span>01</span>
        {copy.input}
      </p>
      <slot name="input" />
    </div>
    <div class="flow-connector" aria-hidden="true">
      <Icon name="arrow" size={20} />
    </div>
    <div class="flow-card flow-process">
      <p class="flow-step">
        <span>02</span>
        {copy.process}
      </p>
      <slot name="process" />
    </div>
    <div class="flow-connector" aria-hidden="true">
      <Icon name="arrow" size={20} />
    </div>
    <div class="flow-card flow-result">
      <p class="flow-step">
        <span>03</span>
        {copy.output}
      </p>
      <div class="result-placeholder" data-demo-placeholder>
        <span class="result-orbit">
          <Icon name="activity" size={25} />
        </span>
        <strong>{copy.ready}</strong>
      </div>
      <pre class="result-code" data-demo-output hidden></pre>
      <p
        class="result-status"
        data-demo-status
        role="status"
        aria-live="polite"
      >
        {copy.pending}
      </p>
    </div>
  </div>
  <div class="flow-footer">
    <p data-demo-note>{note}</p>
    <button class="demo-run" type="submit">
      <Icon name="bolt" size={16} />
      {copy.run}
      <Icon name="arrow" size={16} />
    </button>
  </div>
</form>
