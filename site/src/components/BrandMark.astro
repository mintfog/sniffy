---
import { localePath, siteCopy, type Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
  imageSize?: number;
}

const { lang, imageSize = 26 } = Astro.props;
const copy = siteCopy[lang].home.a11y;
---

<a class="brand" href={localePath(lang, "/")} aria-label={copy.brandHome}>
  <img src="/sniffy-mark.png" alt="" width={imageSize} height={imageSize} />
  <span>Sniffy</span>
</a>

<style>
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 19px;
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--ink);
  }
  .brand img {
    object-fit: contain;
  }
  .brand:hover {
    opacity: 0.88;
  }

  @media (max-width: 760px) {
    .brand {
      font-size: 18px;
      gap: 7px;
    }
    .brand img {
      width: 24px;
      height: 24px;
    }
  }
</style>
